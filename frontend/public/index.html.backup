 <div class="twocol section">
  <div class="card intel-card"><div class="intel-head"><div><h2>Team detail</h2><p>Evidence behind workload and action gaps.</p></div></div><div id="teamDetail"><div class="empty">Select a team above.</div></div></div>
  <div class="card intel-card"><div class="intel-head"><div><h2>Owner accountability</h2><p>Open problem ownership across the workspace.</p></div></div><div id="ownerTable"><div class="empty">Loading…</div></div></div>
 </div>
</section>


<section id="automation" class="view">
