 <div class="toolbar"><button class="btn primary" onclick="loadExecutive()">Refresh intelligence</button><button class="btn" onclick="saveExecutiveSnapshot()">Save snapshot</button></div></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Business health</div><div class="value" id="execHealth">—</div><div class="sub" id="execHealthLabel">Loading…</div></div>
  <div class="card metric"><div class="label">Negative feedback</div><div class="value" id="execNegative">—</div><div class="sub" id="execNegativeChange">—</div></div>
  <div class="card metric"><div class="label">Open high-priority</div><div class="value" id="execHigh">—</div><div class="sub">Problems requiring attention</div></div>
  <div class="card metric"><div class="label">Customers affected</div><div class="value" id="execCustomers">—</div><div class="sub">Named customers in feedback</div></div>
  <div class="card metric"><div class="label">Pending automation</div><div class="value" id="execAutomation">—</div><div class="sub">Human review required</div></div>
 </div>
 <div class="section twocol">
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>What needs attention now</h2><span class="legend">Priority × impact × risk</span></div><div id="execAttention"></div></div>
