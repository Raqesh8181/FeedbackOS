<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FeedbackOS — Executive & Business Intelligence</title>
<style>
:root{--bg:#f7f8fa;--panel:#fff;--ink:#172033;--muted:#718096;--line:#e7eaf0;--accent:#635bff;--accent2:#4f46e5;--red:#dc3c4a;--orange:#d97706;--green:#15945a;--yellow:#b7791f;--shadow:0 8px 30px rgba(25,35,55,.06)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}
.app{display:flex;min-height:100vh}.sidebar{width:238px;background:#101522;color:#d9deea;padding:22px 14px;position:fixed;inset:0 auto 0 0}.brand{display:flex;align-items:center;gap:10px;padding:4px 10px 28px;color:#fff;font-weight:750;font-size:18px}.logo{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#8b7cff,#5146d8);display:grid;place-items:center;color:white;font-weight:800}.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;color:#aeb7c9;text-align:left;padding:11px 12px;border-radius:8px;display:flex;gap:11px;align-items:center}.nav button.active,.nav button:hover{background:#1d2535;color:#fff}.nav small{display:block;color:#68738a;text-transform:uppercase;letter-spacing:.1em;font-size:10px;padding:24px 12px 8px}.workspace{position:absolute;bottom:18px;left:14px;right:14px;padding:12px;border:1px solid #293245;border-radius:10px;color:#9aa6bb}.workspace b{display:block;color:#fff;font-size:12px}.main{margin-left:238px;width:calc(100% - 238px)}.topbar{height:68px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;position:sticky;top:0;z-index:5}.crumb{font-size:13px;color:var(--muted)}.top-actions{display:flex;gap:9px;align-items:center}.btn{border:1px solid var(--line);background:#fff;padding:9px 13px;border-radius:8px;color:var(--ink);font-weight:650}.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.btn.primary:hover{background:var(--accent2)}.content{padding:28px 30px 50px;max-width:1450px;margin:auto}.page-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:23px}.page-head h1{font-size:25px;margin:0 0 5px;letter-spacing:-.02em}.page-head p{margin:0;color:var(--muted)}.grid4{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}.metric{padding:18px}.metric .label{color:var(--muted);font-size:12px;font-weight:600}.metric .value{font-size:28px;font-weight:760;margin:5px 0}.delta{font-size:12px;font-weight:700}.down{color:var(--green)}.up{color:var(--red)}.section{margin-top:18px}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.section-head h2{font-size:15px;margin:0}.twocol{display:grid;grid-template-columns:1.6fr 1fr;gap:16px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:13px 16px;border-bottom:1px solid var(--line);text-align:left}.table th{font-size:11px;color:#8791a4;text-transform:uppercase;letter-spacing:.06em}.table tr:last-child td{border-bottom:0}.table tbody tr:hover{background:#fafbfe}.problem-name{font-weight:700}.sub{font-size:12px;color:var(--muted);margin-top:2px}.pill{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:4px 8px;font-size:11px;font-weight:750;text-transform:capitalize}.critical,.high{background:#fff0f1;color:#bd2635}.medium{background:#fff7e6;color:#a76300}.low{background:#eef9f3;color:#167b4e}.status{background:#f1f3f7;color:#596579}.monitoring{background:#eef4ff;color:#3f64b5}.resolved{background:#eef9f3;color:#167b4e}.chart-card{padding:18px}.chart-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.chart-title b{font-size:13px}.legend{font-size:11px;color:var(--muted)}.chart{height:180px;position:relative}.chart svg{width:100%;height:100%;overflow:visible}.axis{stroke:#e8ebf1;stroke-width:1}.line{fill:none;stroke:#635bff;stroke-width:2.5}.area{fill:rgba(99,91,255,.08)}.dot{fill:#fff;stroke:#635bff;stroke-width:2}.empty{padding:35px;text-align:center;color:var(--muted)}.view{display:none}.view.active{display:block}.searchbar{display:flex;gap:8px;margin-bottom:12px}.searchbar input{flex:1;border:1px solid var(--line);border-radius:8px;padding:10px 12px;background:#fff}.import{border:1px dashed #cbd1dd;padding:28px;border-radius:12px;background:#fff;text-align:center}.import input{margin:12px 0}.detail-overlay{position:fixed;inset:0;background:rgba(15,20,30,.28);z-index:20;display:none}.drawer{position:absolute;right:0;top:0;height:100%;width:min(680px,95vw);background:#fff;overflow:auto;padding:24px;box-shadow:-15px 0 45px rgba(0,0,0,.12)}.drawer.show{display:block}.overlay.show{display:block}.drawer-head{display:flex;justify-content:space-between;gap:15px}.drawer h2{margin:0;font-size:23px}.close{border:0;background:#f2f4f7;border-radius:8px;width:34px;height:34px}.detail-meta{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 22px}.info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.info{border:1px solid var(--line);border-radius:9px;padding:12px}.info span{display:block;color:var(--muted);font-size:11px}.info b{display:block;margin-top:3px}.detail-section{margin-top:22px}.detail-section h3{font-size:13px;margin:0 0 10px}.feedback-item{padding:12px 0;border-bottom:1px solid var(--line)}.feedback-item:last-child{border-bottom:0}.feedback-item p{margin:5px 0}.toolbar{display:flex;gap:8px}.select{border:1px solid var(--line);padding:8px;border-radius:8px;background:#fff}.toast{position:fixed;right:20px;bottom:20px;background:#172033;color:#fff;padding:12px 15px;border-radius:9px;display:none;z-index:30;box-shadow:var(--shadow)}.toast.show{display:block}.modal{position:fixed;inset:0;background:rgba(15,20,30,.4);display:none;place-items:center;z-index:25}.modal.show{display:grid}.modal-card{width:min(560px,92vw);background:#fff;border-radius:14px;padding:22px}.modal-card h3{margin:0 0 5px}.modal-card p{color:var(--muted);margin-top:0}.drop{border:1px dashed #bcc4d2;border-radius:10px;padding:24px;text-align:center}.drop input{margin:12px}.loading{opacity:.6;pointer-events:none}.intel-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:14px}.intel-card{padding:18px}.intel-head{display:flex;justify-content:space-between;gap:12px;align-items:start}.intel-head h2{margin:0;font-size:15px}.intel-head p{margin:4px 0 0;color:var(--muted);font-size:12px}.intel-list{margin:14px 0 0;padding:0;list-style:none}.intel-list li{padding:9px 0;border-bottom:1px solid var(--line)}.intel-list li:last-child{border-bottom:0}.intel-next{margin-top:14px;padding:12px;border-radius:9px;background:#f5f3ff;border:1px solid #e7e3ff}.intel-next b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#5b50c8}.timeline{display:grid;gap:8px;margin-top:12px}.timeline-item{display:flex;gap:10px;align-items:start}.timeline-dot{width:8px;height:8px;border-radius:50%;background:#635bff;margin-top:6px;flex:0 0 auto}.timeline-date{font-size:11px;color:var(--muted)}.timeline-label{font-size:12px;font-weight:650}.copilot-wrap{max-width:980px;margin:0 auto}.copilot-card{padding:20px}.copilot-messages{min-height:360px;max-height:55vh;overflow:auto;display:grid;gap:12px;padding:4px}.chat-row{display:flex}.chat-row.user{justify-content:flex-end}.bubble{max-width:78%;padding:12px 14px;border-radius:12px;border:1px solid var(--line);white-space:pre-wrap}.chat-row.user .bubble{background:#f5f3ff;border-color:#e7e3ff}.chat-row.assistant .bubble{background:#fff}.copilot-form{display:flex;gap:9px;margin-top:14px}.copilot-form textarea{flex:1;min-height:52px;max-height:140px;resize:vertical;border:1px solid var(--line);border-radius:9px;padding:11px 12px}.suggestions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.suggestions button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 10px;font-size:12px;color:#536075}.answer-meta{margin-top:7px;font-size:11px;color:var(--muted)}.decision-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:14px}.decision-card{padding:18px}.decision-head{display:flex;justify-content:space-between;gap:12px;align-items:start}.decision-head h2{margin:0;font-size:15px}.decision-head p{margin:4px 0 0;color:var(--muted);font-size:12px}.priority-list{display:grid;gap:10px;margin-top:14px}.priority-item{border:1px solid var(--line);border-radius:10px;padding:14px}.priority-top{display:flex;justify-content:space-between;gap:10px}.priority-rank{font-size:11px;font-weight:800;color:#5b50c8}.priority-item h3{margin:4px 0;font-size:14px}.decision-action{margin-top:10px;padding:10px;border-radius:8px;background:#f7f7fb}.risk-list,.rule-list{margin:12px 0 0;padding-left:18px}.risk-list li,.rule-list li{margin:7px 0}.plan-list{display:grid;gap:8px;margin-top:12px}.plan-row{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.plan-row:last-child{border-bottom:0}.plan-day{min-width:64px;font-size:11px;font-weight:750;color:var(--muted)}.ops-hero{display:grid;grid-template-columns:1.4fr .6fr;gap:14px}.ops-stat{padding:16px}.ops-stat .big{font-size:24px;font-weight:780;margin-top:3px}.ops-queue{display:grid;gap:9px}.ops-item{border:1px solid var(--line);border-radius:10px;padding:13px}.ops-item h3{font-size:14px;margin:4px 0}.ops-meta{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.ops-focus{padding:13px;border-radius:9px;background:#f5f3ff;border:1px solid #e7e3ff;margin-top:12px}.ops-check{display:grid;gap:8px}.ops-check div{padding:10px 12px;border:1px solid var(--line);border-radius:8px}.ops-note{font-size:11px;color:var(--muted);margin-top:10px}@media(max-width:950px){.ops-hero{grid-template-columns:1fr}}@media(max-width:950px){.decision-grid{grid-template-columns:1fr}}@media(max-width:950px){.intel-grid{grid-template-columns:1fr}}@media(max-width:1200px){.grid4{grid-template-columns:repeat(3,1fr)}}@media(max-width:950px){.sidebar{width:70px}.brand span,.nav button span,.nav small,.workspace{display:none}.main{margin-left:70px;width:calc(100% - 70px)}.grid4{grid-template-columns:repeat(2,1fr)}.twocol{grid-template-columns:1fr}}@media(max-width:600px){.grid4{grid-template-columns:1fr}.topbar{padding:0 15px}.content{padding:20px 15px}.sidebar{display:none}.main{margin-left:0;width:100%}.page-head{align-items:start;gap:10px}.page-head .toolbar{flex-wrap:wrap}.twocol{grid-template-columns:1fr}}
.graph-layout{display:grid;grid-template-columns:1fr 310px;gap:14px}.graph-card{padding:14px;overflow:hidden}.graph-canvas{height:620px;border:1px solid var(--line);border-radius:10px;background:#fbfcfe;position:relative}.graph-canvas svg{width:100%;height:100%;display:block}.graph-edge{stroke:#cfd5df;stroke-width:1.2}.graph-edge.strong{stroke:#8e86ff;stroke-width:2}.graph-node{cursor:pointer}.graph-node circle{stroke:#fff;stroke-width:2}.graph-node text{font-size:10px;fill:#4b5567;pointer-events:none}.graph-node.problem circle{fill:#635bff}.graph-node.feedback circle{fill:#9aa4b2}.graph-node.customer circle{fill:#15945a}.graph-node.action circle{fill:#d97706}.graph-node.owner circle{fill:#172033}.graph-legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}.graph-legend span{font-size:11px;color:var(--muted)}.graph-legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:4px}.graph-side{display:grid;gap:14px}.graph-side .card{padding:16px}.graph-stat{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line)}.graph-stat:last-child{border-bottom:0}.root-item{padding:10px 0;border-bottom:1px solid var(--line);cursor:pointer}.root-item:last-child{border-bottom:0}.root-item b{font-size:12px}.graph-note{padding:10px 12px;background:#f5f3ff;border:1px solid #e7e3ff;border-radius:9px;font-size:12px}@media(max-width:1000px){.graph-layout{grid-template-columns:1fr}.graph-canvas{height:520px}}.auth-screen{min-height:100vh;display:grid;place-items:center;background:var(--bg);padding:24px}.auth-card{width:min(480px,94vw);background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;box-shadow:var(--shadow)}.auth-card h1{margin:0 0 6px}.auth-card p{color:var(--muted)}.auth-form{display:grid;gap:10px;margin-top:18px}.auth-form input{border:1px solid var(--line);border-radius:8px;padding:11px 12px}.auth-tabs{display:flex;gap:8px;margin-top:18px}.auth-tabs button{flex:1}.auth-error{color:#bd2635;font-size:12px;min-height:18px}.account-bar{display:flex;align-items:center;gap:8px}.account-name{font-size:12px;color:var(--muted)}
.ops-health{padding:16px}.ops-table{width:100%;border-collapse:collapse}.ops-table th,.ops-table td{padding:10px 14px;border-bottom:1px solid var(--line);text-align:left;font-size:12px}.ops-table th{font-size:10px;color:#8791a4;text-transform:uppercase}.ok{color:#167b4e;font-weight:750}.bad{color:#bd2635;font-weight:750}</style>
</head>
<body>
<div id="authScreen" class="auth-screen">
 <div class="auth-card">
  <div class="brand" style="color:#172033;padding:0 0 8px"><div class="logo">F</div><span>FeedbackOS</span></div>
  <h1 id="authTitle">Create your workspace</h1><p id="authSubtitle">Register the first admin account, then invite your team.</p>
  <div class="auth-tabs"><button class="btn primary" id="showRegister">Register</button><button class="btn" id="showLogin">Sign in</button></div>
  <form id="registerForm" class="auth-form"><input id="regName" placeholder="Your name" required><input id="regEmail" type="email" placeholder="Work email" required><input id="regPassword" type="password" minlength="8" placeholder="Password (8+ characters)" required><input id="regWorkspace" placeholder="Workspace name" required><button class="btn primary" type="submit">Create workspace</button></form>
  <form id="loginForm" class="auth-form" style="display:none"><input id="loginEmail" type="email" placeholder="Work email" required><input id="loginPassword" type="password" placeholder="Password" required><button class="btn primary" type="submit">Sign in</button></form>
  <div id="authError" class="auth-error"></div>
 </div>
</div>
<div class="app" id="appShell" style="display:none">
<aside class="sidebar">
  <div class="brand"><div class="logo">F</div><span>FeedbackOS</span></div>
  <div class="nav">
    <button class="active" data-view="dashboard">◈ <span>Overview</span></button>
    <button data-view="problems">◉ <span>Problems</span></button>
    <button data-view="feedback">◌ <span>Feedback</span></button>
    <button data-view="copilot">✦ <span>Copilot</span></button>
    <button data-view="operations">⚡ <span>Operations</span></button>
    <button data-view="decision">✓ <span>Decision plan</span></button>
    <button data-view="learning">↗ <span>Learning</span></button>
    <button data-view="memory">◫ <span>Memory</span></button>
    <button data-view="graph">⌘ <span>Intelligence graph</span></button>
    <button data-view="investigation">◎ <span>Investigation</span></button>
    <button data-view="prevention">△ <span>Prevention</span></button>
    <button data-view="strategy">◆ <span>Strategy & portfolio</span></button>
    <button data-view="segments">◉ <span>Customer segments</span></button>
    <button data-view="journey">◍ <span>Customer journey</span></button>
    <button data-view="features">▣ <span>Product & features</span></button>
    <button data-view="teams">♟ <span>Team accountability</span></button>
    <button data-view="automation">⚙ <span>Automation</span></button>
    <button data-view="executive">▤ <span>Executive intelligence</span></button>
    <button data-view="os">◈ <span>FeedbackOS OS</span></button>

    <small>Workspace</small>
    <button data-view="workspace">⚙ <span>Workspace & team</span></button>
    <button data-view="security">▣ <span>Security & permissions</span></button>
    <button data-view="saasops">♥ <span>SaaS Operations</span></button>
    <button data-view="quality">✓ <span>Data Quality</span></button>
    <button data-view="aigov">◈ <span>AI Governance</span></button>
    <button data-view="ailab">◎ <span>AI Quality Lab</span></button>
    <button data-view="aiLearning">↻ <span>AI Learning Loop</span></button>
    <button data-view="product" id="productNav" style="display:none">🚀 <span>Product Launch OS</span></button>
    <small id="superAdminNavLabel" style="display:none">Platform</small>
    <button data-view="superadmin" id="superAdminNav" style="display:none">★ <span>Super Admin</span></button>
    <button data-view="launch" id="launchNav" style="display:none">✨ <span>Launch Experience</span></button>
    <button data-view="launchAnalytics" id="launchAnalyticsNav" style="display:none">📈 <span>Launch Analytics</span></button>
    <button data-view="experiments" id="experimentsNav" style="display:none">🧪 <span>Experiments</span></button>
    <button data-view="revenue" id="revenueNav" style="display:none">💰 <span>Revenue Command</span></button>
    <button data-view="retention" id="retentionNav">♻ <span>Retention & Churn</span></button>
    <button data-view="import">↥ <span>Import data</span></button>
  </div>
  <div class="workspace"><b id="workspaceName">Workspace</b><span id="workspaceUser">Signed in</span></div>
</aside>
<main class="main">
<header class="topbar"><div class="crumb">Workspace / <b id="crumb">Overview</b></div><div class="top-actions"><span class="account-name" id="accountName"></span><button class="btn" id="logoutBtn">Sign out</button><button class="btn" id="seedBtn">Load demo data</button><button class="btn primary" id="importBtn">Import CSV</button></div></header>
<div class="content">
<div id="releaseBanner" class="card" style="display:none;margin-bottom:18px;padding:15px 18px;background:#171b2a;color:#fff;border-color:#2b3348"></div>
<section id="dashboard" class="view active">
 <div class="page-head"><div><h1>Customer feedback health</h1><p>Turn customer feedback into problems, action, and measurable improvement.</p></div><button class="btn primary" id="analyzeBtn">Analyze workspace</button></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Negative feedback</div><div class="value" id="mNegative">—</div><div class="delta" id="mNegativeDelta">Loading…</div></div>
  <div class="card metric"><div class="label">Recurring problems</div><div class="value" id="mProblems">—</div><div class="delta">Detected across feedback</div></div>
  <div class="card metric"><div class="label">Resolved problems</div><div class="value" id="mResolved">—</div><div class="delta down">Tracked to outcome</div></div>
  <div class="card metric"><div class="label">Positive feedback</div><div class="value" id="mPositive">—</div><div class="delta">Customer signals</div></div><div class="card metric"><div class="label">Action outcomes</div><div class="value" id="mOutcomes">—</div><div class="delta" id="mOutcomesDelta">Measured actions</div></div>
  <div class="card metric"><div class="label">Customer Feedback Health</div><div class="value" id="mHealth">—</div><div class="delta" id="mHealthDelta">Resolution + trend</div></div>
 </div>
 <div class="section card" id="alertsCard" style="display:none"><div class="section-head" style="padding:16px 18px 0"><h2>Signals & alerts</h2><span class="legend">Live from workspace data</span></div><div id="alerts"></div></div>
 <div class="section twocol">
   <div class="card chart-card"><div class="chart-title"><b>Negative feedback trend</b><span class="legend">Last 14 days</span></div><div class="chart" id="healthChart"></div></div>
   <div class="card chart-card"><div class="chart-title"><b>What needs attention</b><span class="legend">Priority × volume</span></div><div id="attention"></div></div>
 </div>
 <div class="section twocol">
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Active problems</h2><button class="btn" onclick="showView('problems')">View all</button></div><div id="activeTable"></div></div>
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Improving</h2></div><div id="improving"></div></div>
 </div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Recommended next actions</h2><span class="legend">Highest-impact open problems</span></div><div id="recommendations"></div></div>
 <div class="section intel-grid">
  <div class="card intel-card"><div class="intel-head"><div><h2>Intelligence Center</h2><p>Executive readout of what changed, what matters, and what to do next.</p></div><button class="btn" id="refreshIntel">Refresh</button><button class="btn" id="measureAllBtn">Measure outcomes</button></div><div id="intelSummary"><div class="empty">Loading intelligence…</div></div></div>
  <div class="card intel-card"><div class="intel-head"><div><h2>Customer health timeline</h2><p>Major signals from feedback, actions, and resolutions.</p></div></div><div id="intelTimeline"><div class="empty">Loading timeline…</div></div></div>
 </div>
</section>

<section id="problems" class="view">
 <div class="page-head"><div><h1>Problems</h1><p>Recurring customer issues detected from your feedback.</p></div><div class="toolbar"><button class="btn" id="detectBtn">Detect recurring problems</button><select class="select" id="priorityFilter"><option value="">All priorities</option><option>critical</option><option>high</option><option>medium</option><option>low</option></select></div></div>
 <div class="card"><div id="problemsTable"></div></div>
</section>

<section id="feedback" class="view">
 <div class="page-head"><div><h1>Feedback</h1><p>Raw customer evidence and AI interpretation stay together.</p></div><button class="btn primary" id="addFeedbackBtn">Add feedback</button></div>
 <div class="searchbar"><input id="feedbackSearch" placeholder="Search feedback, source or category…"><button class="btn" onclick="loadFeedback()">Search</button></div>
 <div class="card"><div id="feedbackTable"></div></div>
</section>

<section id="copilot" class="view">
 <div class="page-head"><div><h1>FeedbackOS Copilot</h1><p>Ask questions about customer problems, trends, actions, and outcomes.</p></div><button class="btn" id="clearCopilot">Clear</button></div>
 <div class="copilot-wrap">
  <div class="card copilot-card">
   <div class="sub">Copilot only uses the data already in this FeedbackOS workspace. It can analyze the evidence, but it will not make changes on your behalf.</div>
   <div class="suggestions" id="copilotSuggestions">
    <button data-q="What should we fix first?">What should we fix first?</button>
    <button data-q="Why are customers complaining more?">Why are customers complaining more?</button>
    <button data-q="Did our actions actually work?">Did our actions actually work?</button>
    <button data-q="What is getting worse?">What is getting worse?</button>
    <button data-q="Which problems have the biggest impact?">Which problems have the biggest impact?</button>
   </div>
   <div class="copilot-messages" id="copilotMessages"><div class="chat-row assistant"><div class="bubble">Hi — I’m your FeedbackOS Copilot. Ask me what is changing, what to fix first, or whether recent actions are working.</div></div></div>
   <form class="copilot-form" id="copilotForm"><textarea id="copilotInput" placeholder="Ask about your customer feedback…" aria-label="Ask FeedbackOS Copilot"></textarea><button class="btn primary" id="copilotSend" type="submit">Ask</button></form>
  </div>
 </div>
</section>

<section id="operations" class="view">
 <div class="page-head"><div><h1>Operations center</h1><p>One place to decide what needs attention today. Recommendations require explicit approval.</p></div><div class="toolbar"><button class="btn" id="refreshOps">Refresh</button><button class="btn primary" id="runOps">Run operating loop</button></div></div>
 <div class="ops-hero">
  <div class="card intel-card"><div class="intel-head"><div><h2>Today's operating brief</h2><p>Current customer signals translated into an actionable queue.</p></div><span class="pill monitoring" id="opsSource">Workspace</span></div><div id="opsHeadline" class="ops-focus"><b>Loading…</b></div><div id="opsNotes" class="intel-list"></div><div class="ops-note">The operating loop can analyze new feedback and measure completed actions, but never makes production changes automatically.</div></div>
  <div class="card ops-stat"><div class="label">Customer health</div><div class="big" id="opsHealth">—</div><div class="sub">Workspace score</div><div style="margin-top:18px" class="label">Open actions</div><div class="big" id="opsOpenActions">—</div><div class="sub" id="opsActionSub">—</div><div style="margin-top:18px" class="label">Needs attention</div><div class="big" id="opsQueueCount">—</div><div class="sub" id="opsRiskSub">—</div></div>
 </div>
 <div class="section decision-grid">
  <div class="card decision-card"><div class="decision-head"><div><h2>Priority queue</h2><p>Problems FeedbackOS recommends addressing first.</p></div></div><div id="opsPriorities" class="priority-list"></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Risk watch</h2><p>Signals that can turn into larger customer problems.</p></div></div><ul id="opsRisks" class="risk-list"></ul></div>
 </div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Action queue</h2><p>Explicitly approve an action from here, or open the problem for more context.</p></div></div><div id="opsQueue" class="ops-queue"></div></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Operating guardrails</h2><p>How FeedbackOS keeps recommendations under human control.</p></div></div><div id="opsGuardrails" class="ops-check"></div></div>
</section>

<section id="decision" class="view">
 <div class="page-head"><div><h1>Decision plan</h1><p>Turn current customer signals into a focused 7-day operating plan.</p></div><button class="btn primary" id="refreshDecision">Build plan</button></div>
 <div class="card decision-card" id="decisionHeadline"><div class="empty">Build a plan from the current workspace intelligence.</div></div>
 <div class="decision-grid section">
  <div class="card decision-card"><div class="decision-head"><div><h2>Top priorities</h2><p>Ranked by urgency, recurrence, customer impact, and health.</p></div></div><div id="decisionPriorities" class="priority-list"><div class="empty">No plan yet.</div></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Risks to watch</h2><p>Signals that could become larger customer problems.</p></div></div><ul id="decisionRisks" class="risk-list"><li>No plan yet.</li></ul><div class="section-head" style="margin-top:22px"><h2>Decision rules</h2></div><ul id="decisionRules" class="rule-list"></ul></div>
 </div>
 <div class="card decision-card section"><div class="decision-head"><div><h2>7-day operating plan</h2><p>Move from investigation to measurable customer improvement.</p></div></div><div id="decisionWeek" class="plan-list"><div class="empty">No plan yet.</div></div></div>
</section>

<section id="learning" class="view">
 <div class="page-head"><div><h1>Learning intelligence</h1><p>Learn from measured outcomes and reuse what has worked before.</p></div><button class="btn primary" id="refreshLearning">Refresh learning</button></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Measured actions</div><div class="value" id="lMeasured">—</div><div class="delta">Historical evidence</div></div>
  <div class="card metric"><div class="label">Positive outcomes</div><div class="value" id="lPositive">—</div><div class="delta" id="lSuccess">Outcome success</div></div>
  <div class="card metric"><div class="label">Avg. impact</div><div class="value" id="lImpact">—</div><div class="delta">Negative-feedback change</div></div>
  <div class="card metric"><div class="label">Target accuracy</div><div class="value" id="lAccuracy">—</div><div class="delta">Target met rate</div></div>
 </div>
 <div class="section intel-grid">
  <div class="card intel-card"><div class="intel-head"><div><h2>What FeedbackOS is learning</h2><p>Evidence-backed lessons from completed, measured actions.</p></div></div><ul id="learningLessons" class="intel-list"><li>Loading…</li></ul></div>
  <div class="card intel-card"><div class="intel-head"><div><h2>Recommended reuse</h2><p>How to apply historical patterns without over-trusting small samples.</p></div></div><ul id="learningRecommendations" class="intel-list"><li>Loading…</li></ul></div>
 </div>
 <div class="section decision-grid">
  <div class="card decision-card"><div class="decision-head"><div><h2>Action patterns</h2><p>Which categories of intervention have produced better outcomes.</p></div></div><div id="actionPatterns" class="priority-list"></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Team patterns</h2><p>Resolution volume by owner or recommended team.</p></div></div><div id="teamPatterns" class="priority-list"></div></div>
 </div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Recurring problems to learn from</h2><p>Open problems with enough repeated evidence to compare against previous interventions.</p></div></div><div id="learningProblems" class="priority-list"></div></div>
 <div class="sub" style="margin-top:10px">Learning signals are directional. They are not statistical proof of causation, especially with small samples.</div>
</section>

<section id="memory" class="view">
 <div class="page-head"><div><h1>FeedbackOS memory</h1><p>Reusable history of interventions, outcomes, recurring problems, and what worked before.</p></div><button class="btn primary" id="refreshMemory">Refresh memory</button></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Historical actions</div><div class="value" id="memActions">—</div><div class="delta">Recorded interventions</div></div>
  <div class="card metric"><div class="label">Measured outcomes</div><div class="value" id="memMeasured">—</div><div class="delta">Evidence available</div></div>
  <div class="card metric"><div class="label">Successful interventions</div><div class="value" id="memSuccess">—</div><div class="delta" id="memRate">Success rate</div></div>
  <div class="card metric"><div class="label">Failed interventions</div><div class="value" id="memFailed">—</div><div class="delta">Use with caution</div></div>
 </div>
 <div class="section intel-grid">
  <div class="card intel-card"><div class="intel-head"><div><h2>What worked before</h2><p>Concrete lessons from measured outcomes.</p></div></div><ul id="memLessons" class="intel-list"><li>Loading…</li></ul></div>
  <div class="card intel-card"><div class="intel-head"><div><h2>What to avoid</h2><p>Interventions associated with negative outcomes.</p></div></div><ul id="memCautions" class="intel-list"><li>Loading…</li></ul></div>
 </div>
 <div class="section decision-grid">
  <div class="card decision-card"><div class="decision-head"><div><h2>Reusable intervention patterns</h2><p>Historical outcome patterns by problem category.</p></div></div><div id="memPatterns" class="priority-list"></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Recent cases</h2><p>Open a problem to inspect its memory and similar cases.</p></div></div><div id="memCases" class="priority-list"></div></div>
 </div>
 <div class="sub" style="margin-top:10px">Memory is evidence, not certainty. Similar cases are matched using problem language and category; small samples should not be treated as causal proof.</div>
</section>

<section id="graph" class="view">
 <div class="page-head"><div><h1>Intelligence graph</h1><p>Connect customers, feedback, problems, owners, actions, and outcomes to reveal related issues and possible root causes.</p></div><button class="btn primary" id="refreshGraph">Refresh graph</button></div>
 <div class="graph-layout">
  <div class="card graph-card"><div class="graph-canvas" id="graphCanvas"><div class="empty">Loading graph…</div></div><div class="graph-legend"><span><i style="background:#635bff"></i>Problem</span><span><i style="background:#9aa4b2"></i>Feedback</span><span><i style="background:#15945a"></i>Customer</span><span><i style="background:#d97706"></i>Action</span><span><i style="background:#172033"></i>Owner</span></div></div>
  <div class="graph-side">
   <div class="card"><h2 style="margin:0;font-size:15px">Graph coverage</h2><div id="graphStats" style="margin-top:10px"></div></div>
   <div class="card"><h2 style="margin:0;font-size:15px">Possible root causes</h2><p class="sub">Strong relationships between problems. These are investigation leads, not causal proof.</p><div id="rootCauses" class="root-list"></div></div>
   <div class="graph-note"><b>How to read this</b><br>Problems are connected when they share meaningful language, category, owner/team, or customers. Use the graph to investigate relationships before creating another isolated fix.</div>
  </div>
 </div>
</section>

<section id="investigation" class="view">
 <div class="page-head"><div><h1>Investigation & prediction</h1><p>Move from root-cause evidence to confirmed decisions, predictive risk, and measurable action.</p></div><div class="toolbar"><button class="btn primary" onclick="runUnifiedLoop()">Run intelligence loop</button><button class="btn" onclick="refreshRootCauses()">Refresh root causes</button></div></div>
 <div class="section intel-grid"><div class="card intel-card"><div class="intel-head"><div><h2>Open investigation queue</h2><p>Highest-risk recurring problems and their current hypotheses.</p></div></div><div id="investigationQueue" class="priority-list"><div class="empty">Loading…</div></div></div><div class="card intel-card"><div class="intel-head"><div><h2>Prediction</h2><p>7-day risk and action success forecast.</p></div></div><div id="predictionSummary"><div class="empty">Loading…</div></div></div></div>
</section>
<section id="prevention" class="view">
 <div class="page-head"><div><h1>Preventive operations</h1><p>Act before worsening customer problems become expensive.</p></div><button class="btn primary" onclick="loadPrevention()">Refresh preventive queue</button></div>
 <div class="card decision-card"><div id="preventionQueue" class="priority-list"><div class="empty">Loading…</div></div></div>
</section>
<section id="strategy" class="view">
 <div class="page-head"><div><h1>Strategy to execution</h1><p>Connect systemic customer problems to strategic themes, initiatives, resources, and portfolio decisions.</p></div><div class="toolbar"><button class="btn" onclick="recommendThemes()">Recommend themes</button><button class="btn primary" onclick="rebalancePortfolio()">Run portfolio review</button><button class="btn" onclick="saveStrategySnapshot()">Save snapshot</button></div></div>
 <div class="section layout" style="display:grid;grid-template-columns:1fr 1fr;gap:16px"><div class="card intel-card"><div class="intel-head"><div><h2>Strategic themes</h2><p>Systemic areas inferred from recurring problems.</p></div></div><div id="strategyThemes"><div class="empty">Loading…</div></div></div><div class="card intel-card"><div class="intel-head"><div><h2>Portfolio decisions</h2><p>Fund now, sequence, or defer based on impact, effort, confidence, and risk.</p></div></div><div id="portfolioQueue"><div class="empty">Loading…</div></div></div></div>
</section>


<section id="journey" class="view">
 <div class="page-head"><div><h1>Customer journey intelligence</h1><p>See where customers struggle across discovery, onboarding, purchase, delivery, support, refund, and retention.</p></div><div class="toolbar"><button class="btn" onclick="classifyJourney()">Classify feedback</button><button class="btn primary" onclick="loadJourney()">Refresh journey</button></div></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Feedback mapped</div><div class="value" id="journeyFeedback">—</div><div class="sub">Feedback assigned to a journey stage</div></div>
  <div class="card metric"><div class="label">Customers</div><div class="value" id="journeyCustomers">—</div><div class="sub">Customers with journey history</div></div>
  <div class="card metric"><div class="label">Negative feedback</div><div class="value" id="journeyNegative">—</div><div class="sub">Across all journey stages</div></div>
  <div class="card metric"><div class="label">At-risk stages</div><div class="value" id="journeyRisk">—</div><div class="sub">Stages with high negative concentration</div></div>
 </div>
 <div class="twocol section">
  <div class="card intel-card"><div class="intel-head"><div><h2>Customer journey stages</h2><p>Where customer friction concentrates.</p></div></div><div id="journeyStages"></div></div>
  <div class="card intel-card"><div class="intel-head"><div><h2>Customer journey watchlist</h2><p>Customers with the highest negative-feedback concentration.</p></div></div><div id="journeyCustomersList"></div></div>
 </div>
 <div class="section card intel-card"><div class="intel-head"><div><h2>Journey timeline</h2><p>Select a customer to reconstruct their experience over time.</p></div></div><div id="journeyDetail"><div class="empty">Select a customer from the watchlist.</div></div></div>
</section>

<section id="segments" class="view">
 <div class="page-head"><div><h1>Customer & segment intelligence</h1><p>Find where negative feedback concentrates, which customers are at risk, and which segments need attention.</p></div><div class="toolbar"><button class="btn primary" onclick="loadSegments()">Refresh intelligence</button></div></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Feedback</div><div class="value" id="segFeedback">—</div><div class="sub">Total feedback analyzed</div></div>
  <div class="card metric"><div class="label">Named customers</div><div class="value" id="segCustomers">—</div><div class="sub">Customers with identity data</div></div>
  <div class="card metric"><div class="label">Negative feedback</div><div class="value" id="segNegative">—</div><div class="sub">All-time negative reports</div></div>
