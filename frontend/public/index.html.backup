</section>




<section id="aigov" class="view">
 <div class="page-head"><div><h1>AI Governance</h1><p>Monitor AI reliability, confidence, usage, cost, failures, and human corrections before AI output influences decisions.</p></div><button class="btn primary" onclick="loadAIGovernance()">Refresh</button></div>
 <div class="grid4">
  <div class="card metric"><div class="label">AI runs · 30d</div><div class="value" id="aiRuns">—</div><div class="sub" id="aiRunSub">—</div></div>
  <div class="card metric"><div class="label">Failure rate</div><div class="value" id="aiFailureRate">—</div><div class="sub">Completed vs failed runs</div></div>
  <div class="card metric"><div class="label">Avg confidence</div><div class="value" id="aiConfidence">—</div><div class="sub" id="aiLowConfidence">—</div></div>
  <div class="card metric"><div class="label">Token usage</div><div class="value" id="aiTokens">—</div><div class="sub" id="aiCost">—</div></div>
  <div class="card metric"><div class="label">Human overrides</div><div class="value" id="aiOverrides">—</div><div class="sub">Last 30 days</div></div>
 </div>
 <div class="section twocol"><div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>AI policy</h2></div><div style="padding:18px"><div class="form-grid"><label>Model<input id="aiModel" /></label><label>Minimum confidence<input id="aiMinConfidence" type="number" min="0" max="0.99" step="0.01" /></label><label>Max retries<input id="aiMaxRetries" type="number" min="0" max="10" /></label><label>Daily token budget<input id="aiDailyBudget" type="number" min="0" /></label></div><label style="display:block;margin-top:12px"><input id="aiHumanReview" type="checkbox" /> Require human review for low-confidence AI output</label><button class="btn primary" style="margin-top:14px" onclick="saveAIPolicy()">Save policy</button></div></div>
 <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Reliability rules</h2></div><div style="padding:18px" class="sub">Every governed analysis records model, prompt version, structured-output validation, confidence, token usage, estimated cost, latency, and failures. Human overrides are stored separately and auditable.</div></div></div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Recent AI runs</h2></div><div id="aiRunList"></div></div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Human overrides</h2></div><div id="aiOverrideList"></div></div>
</section>

<section id="ailab" class="view">
 <div class="page-head"><div><h1>AI Quality Lab</h1><p>Measure AI accuracy against a golden dataset, compare runs, detect regressions, and keep a measurable baseline.</p></div><div class="toolbar"><button class="btn primary" onclick="runSelectedEvaluation()">Run evaluation</button><button class="btn" onclick="loadAILab()">Refresh</button></div></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Golden datasets</div><div class="value" id="evalDatasets">—</div><div class="sub">Active evaluation sets</div></div>
  <div class="card metric"><div class="label">Evaluation runs</div><div class="value" id="evalRuns">—</div><div class="sub">Historical model tests</div></div>
  <div class="card metric"><div class="label">Latest score</div><div class="value" id="evalScore">—</div><div class="sub" id="evalScoreSub">No completed run</div></div>
  <div class="card metric"><div class="label">Regressions</div><div class="value" id="evalRegressions">—</div><div class="sub">Runs below baseline threshold</div></div>
 </div>
 <div class="section twocol">
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Create golden dataset</h2></div><div style="padding:18px"><input class="searchbar" id="evalDatasetName" placeholder="e.g. Checkout support gold set"><textarea id="evalDatasetDescription" rows="3" style="width:100%;margin-top:10px" placeholder="What should this dataset measure?"></textarea><button class="btn primary" style="margin-top:12px" onclick="createEvalDataset()">Create dataset</button></div></div>
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Add golden case</h2></div><div style="padding:18px"><select class="select" id="evalDatasetSelect"></select><textarea id="evalInput" rows="3" style="width:100%;margin-top:10px" placeholder="Customer feedback input"></textarea><div class="form-grid" style="margin-top:10px"><input id="evalSentiment" placeholder="Expected sentiment"><input id="evalCategory" placeholder="Expected category"><input id="evalSeverity" placeholder="Expected severity"><input id="evalSummary" placeholder="Expected summary"></div><button class="btn primary" style="margin-top:12px" onclick="addEvalCase()">Add case</button></div></div>
 </div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Dataset cases</h2><span class="legend" id="evalCaseCount">—</span></div><div id="evalCaseList"></div></div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Evaluation history</h2></div><div id="evalRunList"></div></div>
</section>

<section id="quality" class="view">
 <div class="page-head"><div><h1>Data Quality Center</h1><p>Find duplicate, malformed, incomplete, and unclassified feedback before it distorts intelligence.</p></div><div class="toolbar"><button class="btn primary" onclick="runQualityScan()">Run quality scan</button><button class="btn" onclick="loadQuality()">Refresh</button></div></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Quality score</div><div class="value" id="qualityScore">—</div><div class="sub">Latest workspace scan</div></div>
  <div class="card metric"><div class="label">Open flags</div><div class="value" id="qualityFlags">—</div><div class="sub" id="qualityCritical">—</div></div>
  <div class="card metric"><div class="label">Duplicates</div><div class="value" id="qualityDuplicates">—</div><div class="sub">Exact normalized matches</div></div>
  <div class="card metric"><div class="label">AI classification gaps</div><div class="value" id="qualityAI">—</div><div class="sub">Missing sentiment/category/severity</div></div>
  <div class="card metric"><div class="label">Retry queue</div><div class="value" id="qualityRetry">—</div><div class="sub">Queued or failed AI retries</div></div>
 </div>
 <div class="section twocol"><div class="card decision-card"><div class="decision-head"><div><h2>Open quality flags</h2><p>Resolve noise and data defects before relying on downstream intelligence.</p></div></div><div id="qualityFlagList" style="margin-top:12px"></div></div>
 <div class="card decision-card"><div class="decision-head"><div><h2>Latest scan</h2><p>Coverage and reliability diagnostics.</p></div></div><div id="qualityRun" style="margin-top:12px"></div></div></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>AI retry queue</h2><p>Failed or incomplete classifications can be retried explicitly.</p></div></div><div id="qualityRetries" style="margin-top:12px"></div></div>
</section>

<section id="saasops" class="view">
 <div class="page-head"><div><h1>SaaS Operations</h1><p>Live reliability, API performance, ingestion and job health for this workspace.</p></div><button class="btn primary" onclick="loadSaaSOps()">Refresh</button></div>
 <div class="grid4">
  <div class="card metric"><div class="label">System status</div><div id="opsStatus" class="value">—</div><div id="opsStatusSub" class="sub">Checking…</div></div>
  <div class="card metric"><div class="label">DB latency</div><div id="opsDb" class="value">—</div><div class="sub">Current health check</div></div>
  <div class="card metric"><div class="label">API error rate</div><div id="opsErrors" class="value">—</div><div id="opsErrorsSub" class="sub">Last 24 hours</div></div>
  <div class="card metric"><div class="label">API latency</div><div id="opsLatency" class="value">—</div><div class="sub">Average · last 24 hours</div></div>
  <div class="card metric"><div class="label">Ingestion failures</div><div id="opsIngest" class="value">—</div><div class="sub">Last 24 hours</div></div>
 </div>
 <div class="section twocol">
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>API performance</h2></div><div id="opsMetrics"></div></div>
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Recent ingestion</h2></div><div id="opsIngestion"></div></div>
 </div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Job runs</h2><button class="btn" onclick="runOpsDiagnostic()">Run diagnostic job</button></div><div id="opsJobs"></div></div>
</section>

<section id="workspace" class="view">
 <div class="page-head"><div><h1>Workspace & team</h1><p>Manage admins, teammates, invitations, integrations, API keys, and the audit trail.</p></div></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Workspace</div><div class="value" id="wsName">—</div><div class="sub" id="wsSlug">—</div></div>
  <div class="card metric"><div class="label">Team members</div><div class="value" id="wsMembers">—</div><div class="sub">Active workspace users</div></div>
  <div class="card metric"><div class="label">Pending invites</div><div class="value" id="wsInvites">—</div><div class="sub">7-day invitations</div></div>
  <div class="card metric"><div class="label">Integrations</div><div class="value" id="wsIntegrations">—</div><div class="sub">Connected sources</div></div>
 </div>
 <div class="section twocol">
  <div class="card decision-card"><div class="decision-head"><div><h2>Team</h2><p>Admins can invite teammates by email.</p></div></div><div id="memberTable" style="margin-top:12px"></div><div class="toolbar" style="margin-top:12px"><input class="searchbar" style="margin:0;max-width:260px;border:1px solid var(--line);padding:9px;border-radius:8px" id="inviteEmail" placeholder="teammate@company.com"><select class="select" id="inviteRole"><option value="member">Member</option><option value="admin">Admin</option></select><button class="btn primary" id="inviteBtn">Invite</button></div><div id="inviteResult" class="sub" style="margin-top:8px"></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Integrations</h2><p>Register a source and test its ingestion path.</p></div></div><div id="integrationList" style="margin-top:12px"></div><div class="toolbar" style="margin-top:12px"><input class="searchbar" style="margin:0;max-width:180px;border:1px solid var(--line);padding:9px;border-radius:8px" id="integrationName" placeholder="Integration name"><select class="select" id="integrationType"><option>webhook</option><option>support</option><option>survey</option><option>app_store</option><option>crm</option></select><button class="btn primary" id="integrationBtn">Connect</button></div></div>
 </div>
 <div class="section twocol">
  <div class="card decision-card"><div class="decision-head"><div><h2>API keys</h2><p>Create keys for external systems. The secret is shown once.</p></div><button class="btn" id="createKeyBtn">Create key</button></div><div id="apiKeyList" style="margin-top:12px"></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Audit trail</h2><p>Account, team, integration, and access events.</p></div></div><div id="auditList" style="margin-top:12px"></div></div>
 </div>
</section>
<section id="security" class="view">
 <div class="section twocol">
  <div class="card decision-card"><div class="decision-head"><div><h2>Permission matrix</h2><p>Effective permissions by workspace role.</p></div></div><div id="rbacMatrix" style="margin-top:12px"></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Active sessions</h2><p>Admins can revoke another user's session.</p></div></div><div id="sessionList" style="margin-top:12px"></div></div>
 </div>
 <div class="section twocol">
  <div class="card decision-card"><div class="decision-head"><div><h2>Security events</h2><p>Recent authentication and access events.</p></div></div><div id="securityEvents" style="margin-top:12px"></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Tenant isolation diagnostic</h2><p>Checks business tables for workspace scope and unscoped rows.</p></div></div><div id="isolationChecks" style="margin-top:12px"></div></div>
 </div>
</section>
<section id="aiLearning" class="view">
 <div class="page-head"><div><h1>AI Learning Loop</h1><p>Turn human corrections into explainable learning signals and candidate patterns. Nothing changes production AI without approval.</p></div><button class="btn primary" onclick="runAILearning()">Run learning analysis</button></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Open learning signals</div><div class="value" id="learnSignals">—</div><div class="delta">Human corrections to review</div></div>
  <div class="card metric"><div class="label">Correction patterns</div><div class="value" id="learnPatterns">—</div><div class="delta">Repeated AI mistakes</div></div>
  <div class="card metric"><div class="label">Learning runs</div><div class="value" id="learnRuns">—</div><div class="delta">Historical analyses</div></div>
  <div class="card metric"><div class="label">Last run</div><div class="value" id="learnLast">—</div><div class="delta">Governed learning</div></div>
 </div>
 <div class="section twocol">
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>What the AI is learning</h2></div><div id="learningPatterns" style="padding:0 18px 18px"><div class="empty">No learning patterns yet.</div></div></div>
  <div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Why this signal exists</h2></div><div id="learningSignalsList" style="padding:0 18px 18px"><div class="empty">No open signals yet.</div></div></div>
 </div>
</section>

<section id="superadmin" class="view">
 <div class="page-head"><div><h1>Super Admin · Launch Control</h1><p>Control the public product roadmap, release gates, feature availability and launch campaigns without exposing platform-wide controls to workspace admins.</p></div><button class="btn primary" onclick="loadSuperAdmin()">Refresh</button></div>
 <div class="grid4">
  <div class="card metric"><div class="label">Users</div><div class="value" id="saUsers">—</div><div class="sub">All platform users</div></div>
  <div class="card metric"><div class="label">Workspaces</div><div class="value" id="saWorkspaces">—</div><div class="sub">Active organizations</div></div>
  <div class="card metric"><div class="label">Paid workspaces</div><div class="value" id="saPaid">—</div><div class="sub">Current paying workspaces</div></div>
  <div class="card metric"><div class="label">MRR</div><div class="value" id="saMrr">—</div><div class="sub">Platform revenue benchmark</div></div>
  <div class="card metric"><div class="label">Live phases</div><div class="value" id="saLive">—</div><div class="sub">Currently released</div></div>
 </div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Release strategy</h2><p>Each phase is independently launchable. A phase can be ready only when its required benchmarks are met, unless you explicitly force the launch.</p></div></div><div id="saPhases" style="margin-top:14px"></div></div>
 <div class="section twocol">
  <div class="card decision-card"><div class="decision-head"><div><h2>Create phase</h2><p>Add a future release without changing production code.</p></div></div><div style="display:grid;gap:8px;margin-top:12px"><input id="saPhaseKey" placeholder="phase-8-growth"><input id="saPhaseName" placeholder="Phase 8 · Growth Intelligence"><input id="saPhaseTagline" placeholder="Short public tagline"><textarea id="saPhaseDescription" rows="3" placeholder="What customers will unlock..."></textarea><select id="saPhaseTier" class="select"><option>free</option><option>pro</option><option>business</option><option>ai</option></select><input id="saPhaseOrder" type="number" value="80" placeholder="Sort order"><button class="btn primary" onclick="createSuperPhase()">Create phase</button></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Launch campaign</h2><p>Turn a release into a curiosity loop with teaser → announcement → CTA.</p></div></div><div style="display:grid;gap:8px;margin-top:12px"><select id="saCampaignPhase" class="select"></select><input id="saCampaignName" placeholder="Version launch campaign"><input id="saCampaignHeadline" placeholder="Something new is coming..."><input id="saCampaignTeaser" placeholder="Teaser shown before launch"><textarea id="saCampaignBody" rows="3" placeholder="Launch announcement copy"></textarea><div class="form-grid"><input id="saCampaignCTA" placeholder="CTA label" value="See what's new"><input id="saCampaignURL" placeholder="CTA URL or route"></div><select id="saCampaignAudience" class="select"><option>all</option><option>free</option><option>pro</option><option>business</option><option>admins</option></select><button class="btn primary" onclick="createSuperCampaign()">Create campaign</button></div></div>
 </div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Launch Experience Control</h2><p>Control exactly what customers see during teaser, early-access, beta and launch stages.</p></div><button class="btn" onclick="loadLaunchAdmin()">Refresh</button></div><div class="grid4" style="margin-top:12px"><div class="card metric"><div class="label">Waitlist</div><div class="value" id="laWait">—</div><div class="sub">Demand captured</div></div><div class="card metric"><div class="label">Beta access</div><div class="value" id="laBeta">—</div><div class="sub">Invited + active</div></div><div class="card metric"><div class="label">Launch events</div><div class="value" id="laEvents">—</div><div class="sub">Customer signals</div></div><div class="card metric"><div class="label">Experiences</div><div class="value" id="laExperiences">—</div><div class="sub">Configured releases</div></div></div><div id="launchAdminList" style="margin-top:14px"></div><div style="display:grid;gap:8px;margin-top:14px"><input id="laKey" placeholder="phase-8-experience"><input id="laHeadline" placeholder="Phase 8 is coming soon"><input id="laSub" placeholder="Short customer-facing message"><textarea id="laBody" rows="3" placeholder="Explain why customers should care..."></textarea><div class="form-grid"><select id="laPhase" class="select"></select><select id="laStage" class="select"><option>teaser</option><option>waitlist</option><option>beta</option><option>launched</option><option>ended</option></select></div><input id="laFeature" placeholder="Optional feature key"><button class="btn primary" onclick="createLaunchExperience()">Create launch experience</button></div></div>
 
<div class="section card decision-card"><div class="decision-head"><div><h2>Campaigns</h2><p>Publish, schedule and end launch campaigns from one place.</p></div></div><div id="saCampaigns" style="margin-top:14px"></div></div>
</section>

<section id="product" class="view">
 <div class="page-head"><div><h1>Product Launch OS</h1><p>Control feature availability, pricing, roadmap, waitlists and upgrade conversion from one platform-level control center.</p></div><button class="btn primary" onclick="loadProductOS()">Refresh</button></div>
 <div class="grid4"><div class="card metric"><div class="label">Paid workspaces</div><div class="value" id="poPaid">—</div><div class="sub">Current customers</div></div><div class="card metric"><div class="label">MRR</div><div class="value" id="poMrr">—</div><div class="sub">Revenue baseline</div></div><div class="card metric"><div class="label">Upgrade events</div><div class="value" id="poEvents">—</div><div class="sub">Conversion signals</div></div><div class="card metric"><div class="label">Completed upgrades</div><div class="value" id="poUpgrades">—</div><div class="sub">Successful upgrades</div></div></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Feature flags & entitlements</h2><p>A feature can exist in production but remain invisible until you enable its flag and release its phase.</p></div></div><div id="poFeatures" style="margin-top:14px"></div></div>
 <div class="section twocol"><div class="card decision-card"><div class="decision-head"><div><h2>Pricing plans</h2><p>Control commercial packaging without changing application code.</p></div></div><div id="poPlans" style="margin-top:14px"></div></div><div class="card decision-card"><div class="decision-head"><div><h2>Upgrade prompts</h2><p>Show users why the next capability is worth unlocking.</p></div></div><div id="poPrompts" style="margin-top:14px"></div></div></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Product roadmap</h2><p>Public/private roadmap items connected to release phases.</p></div></div><div id="poRoadmap" style="margin-top:14px"></div></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Waitlist</h2><p>Capture demand before a phase launches.</p></div></div><div id="poWaitlist" style="margin-top:14px"></div></div>
</section>


<section id="launch" class="view">
 <div class="page-head"><div><h1>✨ What's new in FeedbackOS</h1><p>See what is launching, join early access, and discover newly unlocked capabilities.</p></div><button class="btn primary" onclick="loadLaunchExperience()">Refresh</button></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Release journey</h2><p>FeedbackOS releases move from teaser → early access → beta → launch. Your workspace only sees capabilities that are actually released and entitled.</p></div></div><div id="launchExperiences" style="margin-top:14px"></div></div>
 <div class="section twocol">
  <div class="card decision-card"><div class="decision-head"><div><h2>Early access</h2><p>Join a waitlist for an upcoming phase.</p></div></div><div style="display:grid;gap:8px;margin-top:12px"><input id="launchWaitEmail" placeholder="Work email"><input id="launchWaitName" placeholder="Name"><input id="launchWaitCompany" placeholder="Company"><select id="launchWaitPhase" class="select"></select><button class="btn primary" onclick="joinLaunchWaitlist()">Join early access</button></div></div>
  <div class="card decision-card"><div class="decision-head"><div><h2>Your beta access</h2><p>Capabilities explicitly granted to this workspace.</p></div></div><div id="betaAccessList" style="margin-top:14px"><div class="empty">Loading beta access…</div></div></div>
 </div>
</section>

<section id="launchAnalytics" class="view">
 <div class="page-head"><div><h1>📈 Launch Analytics & Growth</h1><p>Measure demand, funnel conversion, revenue signals and whether a release is creating enough momentum for the next phase.</p></div><div class="toolbar"><select id="laDays" class="select"><option value="7">7 days</option><option value="30" selected>30 days</option><option value="90">90 days</option></select><button class="btn" onclick="loadLaunchAnalytics()">Refresh</button><button class="btn primary" onclick="snapshotLaunchAnalytics()">Save snapshot</button></div></div>
 <div class="grid4"><div class="card metric"><div class="label">Waitlist</div><div class="value" id="lanWait">—</div><div class="sub">Demand captured</div></div><div class="card metric"><div class="label">Beta activations</div><div class="value" id="lanBeta">—</div><div class="sub">Early access engagement</div></div><div class="card metric"><div class="label">Checkout starts</div><div class="value" id="lanCheckout">—</div><div class="sub">Upgrade intent</div></div><div class="card metric"><div class="label">Paid conversions</div><div class="value" id="lanUpgrades">—</div><div class="sub">Completed upgrades</div></div></div>
 <div class="section twocol"><div class="card decision-card"><div class="decision-head"><div><h2>Launch funnel</h2><p>See where curiosity becomes demand, product usage and revenue.</p></div></div><div id="lanFunnel" style="margin-top:14px"></div></div><div class="card decision-card"><div class="decision-head"><div><h2>Growth recommendations</h2><p>Actionable signals based on the current launch data.</p></div></div><div id="lanRecommendations" style="margin-top:14px"></div></div></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Benchmarks</h2><p>Progress toward the business targets that unlock future releases.</p></div></div><div id="lanGoals" style="margin-top:14px"></div></div>
 <div class="section twocol"><div class="card decision-card"><div class="decision-head"><div><h2>Performance by phase</h2><p>Compare demand signals across releases.</p></div></div><div id="lanPhases" style="margin-top:14px"></div></div><div class="card decision-card"><div class="decision-head"><div><h2>Feature interest</h2><p>Which capabilities are getting attention?</p></div></div><div id="lanFeatures" style="margin-top:14px"></div></div></div>
</section>

<section id="retention" class="view">
 <div class="page-head"><div><h1>♻ Retention, Churn & Expansion Intelligence</h1><p>Turn feedback behavior into customer health, churn-risk signals and expansion opportunities. Scores are directional product signals, not contractual churn predictions.</p></div><div class="toolbar"><select id="retDays" class="select"><option value="30">30 days</option><option value="90" selected>90 days</option><option value="180">180 days</option></select><button class="btn primary" onclick="loadRetention()">Refresh</button><button class="btn" onclick="snapshotRetention()">Save snapshot</button></div></div>
 <div class="grid4"><div class="card metric"><div class="label">Customer health</div><div class="value" id="retHealth">—</div><div class="sub">Average signal score</div></div><div class="card metric"><div class="label">Churn risk</div><div class="value" id="retChurn">—</div><div class="sub">Customers needing intervention</div></div><div class="card metric"><div class="label">Revenue at risk</div><div class="value" id="retRevenue">—</div><div class="sub">Estimated from workspace MRR</div></div><div class="card metric"><div class="label">Expansion</div><div class="value" id="retExpansion">—</div><div class="sub">Strong positive usage signals</div></div></div>
 <div class="section twocol"><div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Customers needing attention</h2></div><div id="retCustomers"></div></div><div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Expansion opportunities</h2></div><div id="retExpansionList"></div></div></div>
 <div class="section twocol"><div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Churn reasons</h2></div><div id="retReasons"></div></div><div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Cohorts</h2></div><div id="retCohorts"></div></div></div>
</section>
<section id="revenue" class="view">
 <div class="page-head"><div><h1>💰 Revenue Command Center</h1><p>Connect releases, feature demand, upgrade intent and revenue. Payment processing remains provider-neutral until you connect a billing provider.</p></div><div class="toolbar"><select id="revDays" class="select"><option value="30" selected>30 days</option><option value="7">7 days</option><option value="90">90 days</option></select><button class="btn primary" onclick="loadRevenue()">Refresh</button></div></div>
 <div class="grid4"><div class="card metric"><div class="label">MRR</div><div class="value" id="revMrr">—</div><div class="sub" id="revMrrSub">Current recurring revenue</div></div><div class="card metric"><div class="label">Paid workspaces</div><div class="value" id="revPaid">—</div><div class="sub">Active commercial accounts</div></div><div class="card metric"><div class="label">Upgrade intent</div><div class="value" id="revIntent">—</div><div class="sub">Intent → conversion</div></div><div class="card metric"><div class="label">Checkout conversion</div><div class="value" id="revCheckout">—</div><div class="sub">Checkout → upgrade</div></div></div>
 <div class="section twocol"><div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Revenue by plan</h2></div><div id="revPlans"></div></div><div class="card"><div class="section-head" style="padding:18px 18px 0"><h2>Revenue recommendations</h2></div><div id="revRecommendations"></div></div></div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Feature revenue attribution</h2><span class="legend">Manual/provider-neutral attribution</span></div><div id="revFeatures"></div></div>
 <div class="section card"><div class="section-head" style="padding:18px 18px 0"><h2>Activate a subscription</h2><span class="legend">Super Admin / manual billing control</span></div><div class="form-grid" style="padding:18px"><input id="revWorkspaceId" placeholder="Workspace ID"><select id="revPlan" class="select"><option value="pro">Pro</option><option value="business">Business</option><option value="ai">AI</option></select><select id="revCycle" class="select"><option value="monthly">Monthly</option><option value="yearly">Yearly</option></select><input id="revTrial" type="number" min="0" placeholder="Trial days (0 = active)"><button class="btn primary" onclick="activateSubscription()">Activate plan</button></div><div class="sub" style="padding:0 18px 18px">This records a subscription and updates the workspace plan. It does not charge a card.</div></div>
</section>

<section id="experiments" class="view">
 <div class="page-head"><div><h1>🧪 Experimentation & Launch Optimization</h1><p>Run controlled A/B tests for launch headlines, CTAs, pricing messages and audiences. Keep the winner only after the data supports it.</p></div><button class="btn primary" onclick="loadExperiments()">Refresh</button></div>
 <div class="grid4"><div class="card metric"><div class="label">Experiments</div><div class="value" id="exCount">—</div><div class="sub">Draft, running and completed</div></div><div class="card metric"><div class="label">Running</div><div class="value" id="exRunning">—</div><div class="sub">Live tests</div></div><div class="card metric"><div class="label">Assignments</div><div class="value" id="exAssignments">—</div><div class="sub">Subjects enrolled</div></div><div class="card metric"><div class="label">Conversions</div><div class="value" id="exConversions">—</div><div class="sub">Measured outcomes</div></div></div>
 <div class="section twocol"><div class="card decision-card"><div class="decision-head"><div><h2>Create experiment</h2><p>Start with a hypothesis and one measurable success metric.</p></div></div><div style="display:grid;gap:8px;margin-top:12px"><input id="exKey" placeholder="phase-3-headline-test"><input id="exName" placeholder="Phase 3 launch headline test"><input id="exHypothesis" placeholder="Hypothesis: a customer-outcome headline increases activation"><select id="exMetric" class="select"><option value="upgrade_completed">Paid conversion</option><option value="engaged">Engagement</option><option value="revenue">Revenue</option></select><select id="exAudience" class="select"><option>all</option><option>free</option><option>pro</option><option>business</option><option>admins</option></select><button class="btn primary" onclick="createExperiment()">Create draft</button></div></div>
 <div class="card decision-card"><div class="decision-head"><div><h2>Experiment rules</h2><p>Every running experiment requires at least two enabled variants whose allocations total 100%.</p></div></div><ul class="rule-list"><li>Deterministic assignment prevents users jumping between variants.</li><li>Assignments are workspace/user scoped when authenticated.</li><li>Events are tracked per variant for comparison.</li><li>Complete an experiment only after reviewing the report.</li></ul></div></div>
 <div class="section card decision-card"><div class="decision-head"><div><h2>Experiments</h2><p>Start, pause, inspect and complete controlled launch tests.</p></div></div><div id="experimentList" style="margin-top:14px"></div></div>
</section>

<section id="import" class="view">
 <div class="page-head"><div><h1>Import feedback</h1><p>Upload a CSV to start the Feedback → Problems loop.</p></div></div>
 <div class="import"><h3>Import a CSV</h3><p>Accepted columns: <b>message</b> (required), source, source_id, customer_name, created_at.</p><input type="file" id="csvFile" accept=".csv"><br><button class="btn primary" id="uploadBtn">Import feedback</button><div id="uploadResult" class="sub"></div></div>
 <div class="section card" style="padding:20px"><h3>Next step</h3><p>Process feedback with AI, generate embeddings, detect recurring problems, calculate priority, and rebuild trend metrics.</p><button class="btn primary" id="processBtn">Process & detect with AI</button></div>
</section>
</div>
</main>
</div>

<div class="detail-overlay" id="overlay"><div class="drawer" id="drawer"></div></div>
<div class="modal" id="feedbackModal"><div class="modal-card"><h3>Add feedback</h3><p>Capture one customer signal.</p><div style="display:grid;gap:10px"><select class="select" id="fSource"><option>support</option><option>app_store</option><option>email</option><option>survey</option><option>review</option><option>website</option><option>whatsapp</option></select><input class="searchbar" style="border:1px solid var(--line);padding:10px;border-radius:8px" id="fCustomer" placeholder="Customer name (optional)"><textarea id="fMessage" rows="5" style="border:1px solid var(--line);padding:10px;border-radius:8px;resize:vertical" placeholder="What did the customer say?"></textarea><div style="display:flex;justify-content:end;gap:8px"><button class="btn" onclick="closeModal()">Cancel</button><button class="btn primary" id="saveFeedback">Save feedback</button></div></div></div></div>
<div class="toast" id="toast"></div>
<script>
const $=id=>document.getElementById(id);
const rawFetch=window.fetch.bind(window);
function authHeaders(opts={}){const h=new Headers(opts.headers||{});const t=localStorage.getItem('feedbackos_token');if(t)h.set('Authorization','Bearer '+t);return h}
window.fetch=(url,opts={})=>rawFetch(url,{...opts,headers:authHeaders(opts)});
function showAuthError(msg){$('authError').textContent=msg||''}
function setAuthMode(mode){const reg=mode==='register';$('registerForm').style.display=reg?'grid':'none';$('loginForm').style.display=reg?'none':'grid';$('showRegister').classList.toggle('primary',reg);$('showLogin').classList.toggle('primary',!reg);$('authTitle').textContent=reg?'Create your workspace':'Welcome back';$('authSubtitle').textContent=reg?'Register the first admin account, then invite your team.':'Sign in to your FeedbackOS workspace.';showAuthError('')}
async function bootAuth(){const t=localStorage.getItem('feedbackos_token');if(!t){$('authScreen').style.display='grid';$('appShell').style.display='none';return}try{const r=await rawFetch('/api/auth/me',{headers:{Authorization:'Bearer '+t}});if(!r.ok)throw new Error('Session expired');const d=await r.json();window.currentUser=d.user;$('authScreen').style.display='none';$('appShell').style.display='flex';$('accountName').textContent=`${d.user.name} · ${d.user.role}`;$('workspaceName').textContent=d.user.workspace_name||'Workspace';$('workspaceUser').textContent=d.user.email||'';if(d.user.platform_role==='super_admin'){$('superAdminNav').style.display='flex';$('superAdminNavLabel').style.display='block';$('productNav').style.display='flex';$('revenueNav').style.display='flex'};$('launchNav').style.display='flex';$('launchAnalyticsNav').style.display='flex';$('experimentsNav').style.display='flex';loadReleaseBanner();loadOverview();loadIntelligence()}catch(e){localStorage.removeItem('feedbackos_token');setAuthMode('login');$('authScreen').style.display='grid';$('appShell').style.display='none'}}
$('showRegister').onclick=()=>setAuthMode('register');$('showLogin').onclick=()=>setAuthMode('login');
$('registerForm').onsubmit=async e=>{e.preventDefault();try{const r=await rawFetch('/api/auth/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:$('regName').value,email:$('regEmail').value,password:$('regPassword').value,workspace_name:$('regWorkspace').value})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Registration failed');localStorage.setItem('feedbackos_token',d.token);await bootAuth()}catch(e){showAuthError(e.message)}};
$('loginForm').onsubmit=async e=>{e.preventDefault();try{const r=await rawFetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:$('loginEmail').value,password:$('loginPassword').value})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Login failed');localStorage.setItem('feedbackos_token',d.token);await bootAuth()}catch(e){showAuthError(e.message)}};
$('logoutBtn').onclick=async()=>{try{await rawFetch('/api/auth/logout',{method:'POST',headers:{Authorization:'Bearer '+localStorage.getItem('feedbackos_token')}})}catch(e){}localStorage.removeItem('feedbackos_token');location.reload()};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2600)}
function showView(name){document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));$(name).classList.add('active');document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.view===name));$('crumb').textContent=name[0].toUpperCase()+name.slice(1);if(name==='dashboard')loadOverview();if(name==='problems')loadProblems();if(name==='feedback')loadFeedback();if(name==='decision')loadDecisionPlan();if(name==='learning')loadLearning();if(name==='memory')loadMemory();if(name==='operations')loadOperations();if(name==='graph')loadGraph();if(name==='investigation')loadInvestigation();if(name==='prevention')loadPrevention();if(name==='strategy')loadStrategy();if(name==='segments')loadSegments();if(name==='journey')loadJourney();if(name==='features')loadFeatures();if(name==='teams')loadTeams();if(name==='automation')loadAutomation();if(name==='executive')loadExecutive();if(name==='os')loadOS();if(name==='workspace')loadWorkspace();if(name==='security')loadSecurity();if(name==='saasops')loadSaaSOps();if(name==='quality')loadQuality();if(name==='aigov')loadAIGovernance();if(name==='ailab')loadAILab();if(name==='aiLearning')loadAILearning();if(name==='product')loadProductOS();if(name==='launch')loadLaunchExperience();if(name==='launchAnalytics')loadLaunchAnalytics();if(name==='experiments')loadExperiments();if(name==='revenue')loadRevenue();if(name==='retention')loadRetention()}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));
$('importBtn').onclick=()=>showView('import'); $('addFeedbackBtn').onclick=()=>$('feedbackModal').classList.add('show'); function closeModal(){$('feedbackModal').classList.remove('show')}
$('seedBtn').onclick=async()=>{if(!confirm('Add a demo dataset to this workspace?'))return;const r=await fetch('/api/demo/seed',{method:'POST'});const d=await r.json();if(!r.ok)return toast(d.error||'Seed failed');toast(`Loaded ${d.feedback} feedback items and ${d.problems} problems`);loadOverview()};
$('saveFeedback').onclick=async()=>{const message=$('fMessage').value.trim();if(!message)return toast('Enter customer feedback');const r=await fetch('/api/feedback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source:$('fSource').value,customer_name:$('fCustomer').value,message})});const d=await r.json();if(!r.ok)return toast(d.error||'Save failed');closeModal();$('fMessage').value='';toast('Feedback captured');showView('feedback')};
$('uploadBtn').onclick=async()=>{const f=$('csvFile').files[0];if(!f)return toast('Choose a CSV file');const fd=new FormData();fd.append('file',f);$('uploadBtn').disabled=true;const r=await fetch('/api/feedback/import',{method:'POST',body:fd});const d=await r.json();$('uploadBtn').disabled=false;if(!r.ok)return toast(d.error||'Import failed');$('uploadResult').textContent=`Imported ${d.imported} of ${d.total_rows} rows.`;toast('Import complete');};
$('processBtn').onclick=async()=>{if(!confirm('Analyze all unprocessed feedback, match existing problems, detect new problems, update priority and health?'))return;const b=$('processBtn');b.disabled=true;b.textContent='Analyzing…';try{const d=await api('/api/intelligence/run',{method:'POST'});toast(`Analyzed ${d.processed.processed} · matched ${d.matched.matched} · created ${d.detected.created} problems`);await loadOverview();await loadProblems();await loadIntelligence()}catch(e){toast(e.message)}finally{b.disabled=false;b.textContent='Process & detect with AI'}};$('analyzeBtn').onclick=async()=>{const b=$('analyzeBtn');b.disabled=true;b.textContent='Analyzing…';try{const d=await api('/api/intelligence/run',{method:'POST'});toast(`Workspace analyzed · ${d.detected.created} new problems · ${d.matched.matched} matched`);await loadOverview();await loadProblems();await loadIntelligence()}catch(e){toast(e.message)}finally{b.disabled=false;b.textContent='Analyze workspace'}};

const copilotHistory=[];
function addCopilotMessage(role,text,meta){const wrap=document.createElement('div');wrap.className='chat-row '+role;const b=document.createElement('div');b.className='bubble';b.textContent=text;if(meta){const m=document.createElement('div');m.className='answer-meta';m.textContent=meta;b.appendChild(m)}wrap.appendChild(b);$('copilotMessages').appendChild(wrap);$('copilotMessages').scrollTop=$('copilotMessages').scrollHeight}
async function askCopilot(question){const q=String(question||'').trim();if(!q)return;addCopilotMessage('user',q);$('copilotInput').value='';$('copilotSend').disabled=true;$('copilotSend').textContent='Thinking…';try{const d=await api('/api/copilot',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:q})});addCopilotMessage('assistant',d.answer||'I could not produce an answer.',`${d.source==='ai'?'AI':'Workspace analysis'} · ${new Date(d.generated_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}`)}catch(e){addCopilotMessage('assistant','I could not answer that right now. Check the database connection and try again.')}finally{$('copilotSend').disabled=false;$('copilotSend').textContent='Ask'}}
$('copilotForm').onsubmit=e=>{e.preventDefault();askCopilot($('copilotInput').value)};
document.querySelectorAll('#copilotSuggestions button').forEach(b=>b.onclick=()=>askCopilot(b.dataset.q));
$('clearCopilot').onclick=()=>{$('copilotMessages').innerHTML='<div class="chat-row assistant"><div class="bubble">Conversation cleared. Ask me about your customer feedback workspace.</div></div>'};

function graphColor(type){return {problem:'#635bff',feedback:'#9aa4b2',customer:'#15945a',action:'#d97706',owner:'#172033'}[type]||'#718096'}
function graphLabel(n){const raw=String(n.label||'');return raw.length>26?raw.slice(0,24)+'…':raw}
function renderGraph(g){
 const el=$('graphCanvas'); const nodes=g.nodes||[], edges=g.edges||[]; if(!nodes.length){el.innerHTML='<div class="empty">No graph data yet. Import and process feedback first.</div>';return}
 const W=900,H=620,cx=W/2,cy=H/2; const groups={problem:[],feedback:[],customer:[],action:[],owner:[]}; nodes.forEach(n=>(groups[n.type]||groups.feedback).push(n));
 const pos={};
 const place=(arr,rx,ry,offset)=>arr.forEach((n,i)=>{const a=offset+(i/Math.max(1,arr.length))*Math.PI*2;pos[n.id]={x:cx+Math.cos(a)*rx,y:cy+Math.sin(a)*ry}});
 place(groups.problem,245,185,-Math.PI/2); place(groups.feedback,350,245,0); place(groups.customer,165,260,Math.PI); place(groups.action,360,145,Math.PI/3); place(groups.owner,120,130,-Math.PI/4);
 const visibleEdges=edges.filter(e=>pos[e.source]&&pos[e.target]);
 const line=visibleEdges.map(e=>{const a=pos[e.source],b=pos[e.target];return `<line class="graph-edge ${e.weight>=.42?'strong':''}" x1="${a.x.toFixed(1)}" y1="${a.y.toFixed(1)}" x2="${b.x.toFixed(1)}" y2="${b.y.toFixed(1)}"/>`}).join('');
 const nodeSvg=nodes.map(n=>{const p=pos[n.id];if(!p)return '';const r=n.type==='problem'?10:7;const click=n.type==='problem'?`onclick="openProblem(${Number(n.meta?.id)})"`:'';return `<g class="graph-node ${n.type}" ${click}><circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="${r}"/><text x="${(p.x+13).toFixed(1)}" y="${(p.y+3).toFixed(1)}">${esc(graphLabel(n))}</text></g>`}).join('');
 el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="FeedbackOS intelligence graph">${line}${nodeSvg}</svg>`;
 $('graphStats').innerHTML=Object.entries({Problems:g.stats?.problems||0,Feedback:g.stats?.feedback||0,Customers:g.stats?.customers||0,Actions:g.stats?.actions||0,Owners:g.stats?.owners||0,Relationships:g.stats?.relationships||0}).map(([k,v])=>`<div class="graph-stat"><span class="sub">${k}</span><b>${v}</b></div>`).join('');
 const rc=(g.root_causes||[]); $('rootCauses').innerHTML=rc.length?rc.slice(0,7).map(x=>{const a=nodes.find(n=>n.id===`problem:${x.problem_id}`),b=nodes.find(n=>n.id===`problem:${x.related_problem_id}`);return `<div class="root-item" onclick="openProblem(${x.problem_id})"><b>${esc(a?.label||'Problem #'+x.problem_id)} ↔ ${esc(b?.label||'Problem #'+x.related_problem_id)}</b><div class="sub">${Math.round(Number(x.score)*100)}% relationship · ${esc(x.reason||'multiple shared signals')}</div></div>`}).join(''):'<div class="empty">No strong relationships detected yet.</div>';
}
async function loadGraph(){try{const d=await api('/api/graph');renderGraph(d)}catch(e){$('graphCanvas').innerHTML='<div class="empty">Graph unavailable. Check the database connection.</div>'}}
$('refreshGraph').onclick=async()=>{const b=$('refreshGraph');b.disabled=true;b.textContent='Refreshing…';await loadGraph();b.disabled=false;b.textContent='Refresh graph'};
async function api(url,opts){const r=await fetch(url,opts);const d=await r.json();if(!r.ok)throw new Error(d.error||'Request failed');return d}
async function loadIntelligence(){try{const d=await api('/api/intelligence/summary');const s=d.summary||{};const source=s.source==='ai'?'AI':'rules';$('intelSummary').innerHTML=`<div style="margin-top:14px"><b style="font-size:15px">${esc(s.headline||'No executive summary yet.')}</b><ul class="intel-list">${(s.bullets||[]).map(x=>`<li>${esc(x)}</li>`).join('')}</ul><div class="intel-next"><b>Recommended next move</b><div style="margin-top:4px">${esc(s.next_action||'Analyze the workspace and assign owners to the highest-impact problems.')}</div></div><div class="sub" style="margin-top:9px">Generated ${new Date(d.generated_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} · ${source} summary</div></div>`;const events=(d.timeline||[]).slice(-10).reverse();$('intelTimeline').innerHTML=events.length?`<div class="timeline">${events.map(e=>`<div class="timeline-item"><span class="timeline-dot"></span><div><div class="timeline-date">${esc(e.date)}</div><div class="timeline-label">${esc(e.label||'Signal')}</div>${e.detail?`<div class="sub">${esc(e.detail)}</div>`:''}</div></div>`).join('')}</div>`:'<div class="empty">No major changes recorded yet.</div>'}catch(e){$('intelSummary').innerHTML='<div class="empty">Run workspace analysis after importing feedback.</div>';$('intelTimeline').innerHTML='<div class="empty">No timeline data yet.</div>'}}
$('refreshIntel').onclick=async()=>{const b=$('refreshIntel');b.disabled=true;b.textContent='Refreshing…';await loadIntelligence();b.disabled=false;b.textContent='Refresh'};
async function createDecisionAction(id,description){try{const owner=prompt('Owner (optional):')||null;await api('/api/decision/actions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({problem_id:id,description,owner,expected_impact_percent:prompt('Expected negative-feedback reduction %:','20')})});toast('Decision action created');loadOverview();loadProblems();loadDecisionPlan()}catch(e){toast(e.message)}}

async function loadMemory(){try{const d=await api('/api/memory');const m=d.metrics||{};$('memActions').textContent=Number(m.historical_actions||0);$('memMeasured').textContent=Number(m.measured_actions||0);$('memSuccess').textContent=Number(m.successful_actions||0);$('memFailed').textContent=Number(m.failed_actions||0);$('memRate').textContent=`${Number(m.success_rate||0).toFixed(1)}% success rate`;$('memLessons').innerHTML=(d.lessons||[]).map(x=>`<li>${esc(x)}</li>`).join('')||'<li>Measure completed actions to create reusable memory.</li>';$('memCautions').innerHTML=(d.cautions||[]).map(x=>`<li>${esc(x)}</li>`).join('')||'<li>No failed interventions recorded yet.</li>';$('memPatterns').innerHTML=(d.action_patterns||[]).map(x=>`<div class="priority-item"><div class="priority-top"><span class="priority-rank">${esc(x.category)}</span><span class="pill ${x.avg_impact>0?'low':x.avg_impact<0?'high':'status'}">${Number(x.avg_impact||0).toFixed(1)}% avg impact</span></div><div class="sub">${Number(x.count)} measured · ${Number(x.success_rate||0).toFixed(1)}% positive outcome rate</div></div>`).join('')||'<div class="empty">No reusable patterns yet.</div>';$('memCases').innerHTML=(d.recent_cases||[]).map(p=>`<div class="priority-item" style="cursor:pointer" onclick="openProblem(${Number(p.id)})"><div class="priority-top"><span class="priority-rank">Problem #${Number(p.id)}</span><span class="pill ${p.priority||'medium'}">${esc(p.priority||'medium')}</span></div><h3>${esc(p.title)}</h3><div class="sub">${Number(p.feedback_count||0)} reports · ${esc(p.health||'Insufficient data')} · ${esc(p.status||'')}</div></div>`).join('')||'<div class="empty">No cases yet.</div>'}catch(e){$('memLessons').innerHTML='<li>Unable to load memory.</li>';$('memCautions').innerHTML='<li>Check the database connection and try again.</li>'}}
$('refreshMemory').onclick=async()=>{const b=$('refreshMemory');b.disabled=true;b.textContent='Refreshing…';try{await api('/api/memory/backfill',{method:'POST'});await loadMemory();toast('Memory refreshed')}catch(e){toast(e.message)}finally{b.disabled=false;b.textContent='Refresh memory'}};

async function loadLearning(){try{const d=await api('/api/learning');const m=d.metrics||{};$('lMeasured').textContent=Number(m.measured_actions||0);$('lPositive').textContent=Number(m.positive_actions||0);$('lSuccess').textContent=`${Number(m.success_rate||0).toFixed(1)}% positive outcomes`;$('lImpact').textContent=`${Number(m.avg_impact||0).toFixed(1)}%`;$('lAccuracy').textContent=`${Number(m.target_accuracy||0).toFixed(1)}%`;$('learningLessons').innerHTML=(d.lessons||[]).map(x=>`<li>${esc(x)}</li>`).join('')||'<li>Measure completed actions to create learning evidence.</li>';$('learningRecommendations').innerHTML=(d.recommendations||[]).map(x=>`<li>${esc(x)}</li>`).join('')||'<li>No recommendations yet.</li>';$('actionPatterns').innerHTML=(d.action_patterns||[]).map(x=>`<div class="priority-item"><div class="priority-top"><span class="priority-rank">${esc(x.category)}</span><span class="pill ${x.avg_impact>0?'low':x.avg_impact<0?'high':'status'}">${Number(x.avg_impact||0).toFixed(1)}% avg impact</span></div><div class="sub">${Number(x.count)} measured · ${Number(x.success_rate||0).toFixed(1)}% positive outcome rate</div></div>`).join('')||'<div class="empty">No measured action patterns yet.</div>';$('teamPatterns').innerHTML=(d.team_patterns||[]).map(x=>`<div class="priority-item"><div class="priority-top"><span class="priority-rank">${esc(x.owner)}</span><span class="pill monitoring">${Number(x.resolved||0)} resolved</span></div><div class="sub">${Number(x.problems||0)} problems tracked${x.avg_resolution_days!=null?` · ${Number(x.avg_resolution_days).toFixed(1)} days avg resolution`:''}</div></div>`).join('')||'<div class="empty">No team history yet.</div>';$('learningProblems').innerHTML=(d.recurring_problems||[]).map(x=>`<div class="priority-item"><div class="priority-top"><span class="priority-rank">Problem #${Number(x.id)}</span><span class="pill ${x.priority||'medium'}">${esc(x.priority||'medium')}</span></div><h3>${esc(x.title)}</h3><div class="sub">${Number(x.feedback_count||0)} linked reports · ${esc(x.health||'Insufficient data')} · ${esc(x.owner||'Unassigned')}</div></div>`).join('')||'<div class="empty">No recurring open problems yet.</div>'}catch(e){$('learningLessons').innerHTML='<li>Unable to load learning intelligence.</li>';$('learningRecommendations').innerHTML='<li>Check the database connection and try again.</li>'}}
$('refreshLearning').onclick=async()=>{const b=$('refreshLearning');b.disabled=true;b.textContent='Refreshing…';await loadLearning();b.disabled=false;b.textContent='Refresh learning'};

async function loadOperations(){try{const d=await api('/api/operations/today');const b=d.brief||{};$('opsSource').textContent=d.source==='ai'?'AI operations':'Workspace operations';$('opsHealth').textContent=d.health_score?.score!=null?Number(d.health_score.score):'—';$('opsOpenActions').textContent=Number(b.open_actions||0);$('opsActionSub').textContent=`${Number(b.completed_actions||0)} completed · ${Number(b.measured_actions||0)} measured`;$('opsQueueCount').textContent=Number(b.queue_count||0);$('opsRiskSub').textContent=`${Number(b.risk_count||0)} risks flagged`;$('opsHeadline').innerHTML=`<b>${esc(b.headline||'Operating brief ready.')}</b><div class="sub" style="margin-top:5px">${esc(b.top_focus||'No immediate focus.')}</div>`;const notes=b.focus_notes||[];$('opsNotes').innerHTML=notes.length?notes.map(x=>`<div>${esc(x)}</div>`).join(''):'<div class="sub">Focus is generated from current workspace evidence.</div>';$('opsPriorities').innerHTML=(d.priorities||[]).map(p=>`<div class="priority-item"><div class="priority-top"><span class="priority-rank">#${Number(p.rank)} · Problem #${Number(p.problem_id)}</span><span class="pill ${esc(p.priority||'medium')}">${esc(p.priority||'medium')}</span></div><h3>${esc(p.title)}</h3><div class="sub">${esc(p.owner||'Unassigned')} · ${esc(p.health||'Insufficient data')} · ${Number(p.feedback_count||0)} reports · score ${Number(p.ops_score||0)}</div><p>${esc(p.why||'High current customer impact.')}</p><div class="decision-action"><b>Next move</b><div>${esc(p.next_action||'Investigate and measure the outcome.')}</div></div><button class="btn" style="margin-top:9px" onclick="openProblem(${Number(p.problem_id)})">Open problem</button></div>`).join('')||'<div class="empty">No active problems. Import and analyze feedback to start the operating loop.</div>';$('opsRisks').innerHTML=(d.risks||[]).map(x=>`<li>${esc(x)}</li>`).join('')||'<li>No major risks flagged.</li>';$('opsQueue').innerHTML=(d.queue||[]).map(x=>`<div class="ops-item"><div class="ops-meta"><span class="pill ${esc(x.priority||'medium')}">${esc(x.priority||'medium')}</span><span class="sub">Problem #${Number(x.problem_id)}</span></div><h3>${esc(x.title)}</h3><div class="sub">${esc(x.reason)}</div><p style="margin:7px 0">${esc(x.recommended_action)}</p><div style="display:flex;gap:7px;flex-wrap:wrap"><button class="btn primary" onclick="createOpsAction(${Number(x.problem_id)}, ${JSON.stringify(x.recommended_action||'Investigate and measure the outcome.')})">Approve action</button><button class="btn" onclick="openProblem(${Number(x.problem_id)})">Review</button></div></div>`).join('')||'<div class="empty">No action queue items. The workspace is caught up.</div>';$('opsGuardrails').innerHTML=(d.guardrails||[]).map(x=>`<div>✓ ${esc(x)}</div>`).join('')}catch(e){$('opsHeadline').innerHTML='<b>Unable to load the operations center.</b><div class="sub">Check the database connection and try again.</div>'}}
async function createOpsAction(problemId,description){try{const d=await api('/api/problems/'+problemId);const p=d.problem;const owner=prompt('Owner (optional):',p.owner||p.recommended_team||'')||null;const target=prompt('Expected negative-feedback reduction %:','20');await api('/api/problems/'+problemId+'/actions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({description,owner,expected_impact_percent:target})});toast('Action approved and created');await loadOperations();loadOverview();loadProblems()}catch(e){toast(e.message)}}
$('refreshOps').onclick=loadOperations;$('runOps').onclick=async()=>{const b=$('runOps');b.disabled=true;b.textContent='Running…';try{const d=await api('/api/operations/run',{method:'POST'});toast(`Loop complete · ${d.intelligence?.created||0} new problems · ${d.outcomes?.measured||0} outcomes measured`);await loadOperations();loadOverview();loadProblems();loadLearning()}catch(e){toast(e.message)}finally{b.disabled=false;b.textContent='Run operating loop'}};
async function loadDecisionPlan(){try{const d=await api('/api/decision/plan');$('decisionHeadline').innerHTML='<div><div class="sub">'+(d.source==='ai'?'AI decision engine':'Workspace decision engine')+'</div><b style="font-size:18px">'+esc(d.headline||'Decision plan ready.')+'</b><div class="sub" style="margin-top:5px">Generated '+new Date(d.generated_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+'. This plan recommends actions; nothing is changed automatically.</div></div>';$('decisionPriorities').innerHTML=(d.priorities||[]).map(p=>'<div class="priority-item"><div class="priority-top"><span class="priority-rank">#'+(p.rank||'')+' · Problem #'+p.problem_id+'</span><span class="pill '+(p.priority||'medium')+'">'+esc(p.priority||'medium')+'</span></div><h3>'+esc(p.title||'Problem')+'</h3><div class="sub">'+esc(p.owner||'Unassigned')+' · '+esc(p.health||'Insufficient data')+' · '+(p.feedback_count!=null?Number(p.feedback_count)+' linked reports':'')+'</div><p>'+esc(p.why||'High current customer impact.')+'</p><div class="decision-action"><b>Action</b><div>'+esc(p.action||'Investigate and assign an owner.')+'</div><div class="sub" style="margin-top:6px"><b>Success metric:</b> '+esc(p.success_metric||'Reduce negative feedback.')+'</div></div><button class="btn primary" style="margin-top:10px" onclick="createDecisionAction('+Number(p.problem_id)+', '+JSON.stringify(p.action||'Investigate the problem and measure the result.')+')">Create action</button></div>').join('')||'<div class="empty">No active problems are ready for prioritization.</div>';$('decisionRisks').innerHTML=(d.risks||[]).map(x=>'<li>'+esc(x)+'</li>').join('');$('decisionRules').innerHTML=(d.decision_rules||[]).map(x=>'<li>'+esc(x)+'</li>').join('');$('decisionWeek').innerHTML=(d.seven_day_plan||[]).map(x=>'<div class="plan-row"><div class="plan-day">'+esc(x.day||'This week')+'</div><div><b>Problem #'+(Number(x.problem_id)||'')+'</b><div class="sub">'+esc(x.focus||'Execute and measure the outcome.')+'</div></div></div>').join('')||'<div class="empty">No weekly plan yet.</div>'}catch(e){$('decisionHeadline').innerHTML='<div class="empty">Unable to build a decision plan. Check the database connection.</div>'}}
$('refreshDecision').onclick=async()=>{const b=$('refreshDecision');b.disabled=true;b.textContent='Building…';await loadDecisionPlan();b.disabled=false;b.textContent='Build plan'};
async function loadOverview(){try{const d=await api('/api/overview');$('mNegative').textContent=(d.feedback.negative_feedback||0).toLocaleString();$('mProblems').textContent=(d.problems.total_problems||0).toLocaleString();$('mResolved').textContent=(d.problems.resolved_problems||0).toLocaleString();$('mPositive').textContent=(d.feedback.positive_feedback||0).toLocaleString();$('mOutcomes').textContent=(d.action_outcomes?.measured||0).toLocaleString();$('mOutcomesDelta').textContent=d.action_outcomes?`${d.action_outcomes.met} targets met · avg ${d.action_outcomes.avg_impact.toFixed(1)}% impact`:'Measured actions';$('mHealth').textContent=d.health_score?d.health_score.score+'/100':'—';$('mHealthDelta').textContent=d.health_score?`Resolution ${d.health_score.resolution_rate}% · ${d.health_score.recent_negative} negative / 7d`:'Resolution + trend';const ch=d.weekly.negative_change||0;$('mNegativeDelta').className='delta '+(ch<=0?'down':'up');$('mNegativeDelta').textContent=(ch<=0?'↓ ':'↑ ')+Math.abs(ch)+'% vs previous 7 days';renderAttention(d.active);renderActive(d.active);renderImproving(d.improving);renderRecommendations(d.active||[]);renderAlerts(d.alerts||[]);renderChart(d.trend||[])}catch(e){toast('Connect the database to load the dashboard')}}
function renderRecommendations(rows){const list=(rows||[]).filter(p=>p.recommended_action).slice(0,5);$('recommendations').innerHTML=list.length?list.map(p=>`<div style="padding:13px 18px;border-bottom:1px solid var(--line);display:flex;gap:14px;align-items:flex-start"><span class="pill ${p.priority}">${esc(p.priority)}</span><div style="flex:1"><b>${esc(p.title)}</b><div class="sub" style="margin-top:5px">${esc(p.recommended_action)}</div><div class="sub" style="margin-top:4px">${esc(p.owner||p.recommended_team||'Unassigned')} · ${esc(p.health||'Insufficient data')}</div></div><button class="btn" onclick="openProblem(${p.id})">Act</button></div>`).join(''):'<div class="empty">Analyze the workspace to generate recommendations.</div>'}
function renderAlerts(rows){const card=$('alertsCard');if(!rows.length){card.style.display='none';return}card.style.display='block';$('alerts').innerHTML=rows.map(a=>`<div style="padding:12px 18px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:flex-start"><span class="pill ${a.type==='critical'?'critical':a.type==='warning'?'medium':'low'}">${esc(a.type)}</span><div><b>${esc(a.title)}</b><div class="sub">${esc(a.detail)}</div></div></div>`).join('')}
function renderAttention(rows){$('attention').innerHTML=rows.slice(0,5).map(p=>`<div style="padding:12px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;cursor:pointer" onclick="openProblem(${p.id})"><div><b>${esc(p.title)}</b><div class="sub">${p.feedback_count} reports · ${esc(p.owner||p.recommended_team||'Unassigned')}</div></div><span class="pill ${p.priority}">${p.priority}</span></div>`).join('')||'<div class="empty">No active problems yet.</div>'}
function renderActive(rows){$('activeTable').innerHTML=rows.length?`<table class="table"><thead><tr><th>Problem</th><th>Reports</th><th>Priority</th><th>Status</th></tr></thead><tbody>${rows.slice(0,6).map(p=>`<tr onclick="openProblem(${p.id})" style="cursor:pointer"><td><div class="problem-name">${esc(p.title)}</div><div class="sub">${esc(p.category||'General')}</div></td><td>${p.feedback_count}</td><td><span class="pill ${p.priority}">${p.priority}</span></td><td><span class="pill status">${esc(p.status).replace('_',' ')}</span></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No problems detected. Import feedback or load demo data.</div>'}
function renderImproving(rows){$('improving').innerHTML=rows.length?rows.map(p=>`<div style="padding:14px 18px;border-bottom:1px solid var(--line)"><div style="display:flex;justify-content:space-between"><b>${esc(p.title)}</b><span class="pill monitoring">${esc(p.status)}</span></div><div class="sub" style="margin-top:5px">${p.negative_count||0} negative signals tracked · ${p.feedback_count} linked reports</div></div>`).join(''):'<div class="empty">Resolved or monitoring problems will appear here.</div>'}
async function loadProblems(){try{const rows=await api('/api/problems');const filter=$('priorityFilter').value;const list=filter?rows.filter(x=>x.priority===filter):rows;$('problemsTable').innerHTML=list.length?`<table class="table"><thead><tr><th>Problem</th><th>Volume</th><th>Owner</th><th>Priority</th><th>Health</th><th>Status</th><th></th></tr></thead><tbody>${list.map(p=>`<tr><td><div class="problem-name">${esc(p.title)}</div><div class="sub">${esc(p.description||'')}</div></td><td>${p.feedback_count}</td><td>${esc(p.owner||p.recommended_team||'Unassigned')}</td><td><span class="pill ${p.priority}">${p.priority}</span></td><td><span class="pill ${p.health==='Worsening'?'high':p.health==='Improving'?'low':'status'}">${esc(p.health||'Insufficient data')}</span></td><td><span class="pill status">${esc(p.status).replaceAll('_',' ')}</span></td><td><button class="btn" onclick="openProblem(${p.id})">Open</button></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No problems yet.</div>'}catch(e){toast(e.message)}}
$('priorityFilter').onchange=loadProblems;
$('detectBtn').onclick=async()=>{try{$('detectBtn').disabled=true;const d=await api('/api/problems/detect',{method:'POST'});toast(`Detected ${d.created} new recurring problem${d.created===1?'':'s'}`);await loadProblems();await loadOverview()}catch(e){toast(e.message)}finally{$('detectBtn').disabled=false}};
async function loadFeedback(){try{const q=encodeURIComponent($('feedbackSearch').value.trim());const rows=await api('/api/feedback?limit=150&search='+q);$('feedbackTable').innerHTML=rows.length?`<table class="table"><thead><tr><th>Feedback</th><th>Source</th><th>Sentiment</th><th>Severity</th><th>Problem</th><th>Date</th></tr></thead><tbody>${rows.map(f=>`<tr><td style="max-width:480px"><div class="problem-name" style="font-weight:600">${esc(f.message)}</div><div class="sub">${esc(f.summary||'')}</div></td><td>${esc(f.source)}</td><td>${f.sentiment?`<span class="pill ${f.sentiment==='negative'?'high':'low'}">${f.sentiment}</span>`:'—'}</td><td>${f.severity?`<span class="pill ${f.severity}">${f.severity}</span>`:'—'}</td><td>${f.problem_id?`<button class="btn" onclick="openProblem(${f.problem_id})">View</button>`:'—'}</td><td class="sub">${new Date(f.created_at).toLocaleDateString()}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No feedback found.</div>'}catch(e){toast(e.message)}}
async function openProblem(id){try{const d=await api('/api/problems/'+id);const p=d.problem;$('drawer').innerHTML=`<div class="drawer-head"><div><div class="sub">Problem #${p.id}</div><h2>${esc(p.title)}</h2></div><button class="close" onclick="closeDrawer()">×</button></div><div class="detail-meta"><span class="pill ${p.priority}">${p.priority} priority</span><span class="pill status">${esc(p.status).replaceAll('_',' ')}</span><span class="pill monitoring">${esc(p.recommended_team||'Unassigned')}</span></div><div class="info-grid"><div class="info"><span>Feedback</span><b>${p.feedback_count}</b></div><div class="info"><span>Severity</span><b>${esc(p.severity)}</b></div><div class="info"><span>Health</span><b>${esc(p.health||'Insufficient data')}</b></div><div class="info"><span>Confidence</span><b>${p.confidence!=null?Math.round(Number(p.confidence)*100)+'%':'—'}</b></div><div class="info"><span>Owner</span><b>${esc(p.owner||'Unassigned')}</b></div><div class="info"><span>Last detected</span><b>${new Date(p.last_detected_at).toLocaleDateString()}</b></div></div><div class="detail-section"><h3>Ownership & priority</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><input class="searchbar" style="border:1px solid var(--line);padding:10px;border-radius:8px;margin:0" id="problemOwner" value="${esc(p.owner||'')}" placeholder="Owner or team"><select class="select" id="problemPriority"><option ${p.priority==='critical'?'selected':''}>critical</option><option ${p.priority==='high'?'selected':''}>high</option><option ${p.priority==='medium'?'selected':''}>medium</option><option ${p.priority==='low'?'selected':''}>low</option></select></div><button class="btn primary" style="margin-top:8px" onclick="saveProblemMeta(${p.id})">Save ownership & priority</button></div><div class="detail-section"><h3>AI analysis</h3><div class="card" style="padding:15px"><b>What is happening</b><p>${esc(p.description||'No description yet.')}</p><b>Customer / business impact</b><p>${esc(p.impact||'No impact analysis yet.')}</p></div></div><div class="detail-section"><h3>Resolution effectiveness</h3><div class="card" style="padding:15px"><div class="info-grid"><div class="info"><span>Effectiveness</span><b id="resolutionEffect">${p.resolution_effectiveness!=null?Number(p.resolution_effectiveness).toFixed(1)+'%':'Not measured'}</b></div><div class="info"><span>Outcome</span><b>${esc(p.resolution_summary||'Resolve the problem to establish a before/after measurement.')}</b></div></div><p class="sub" style="margin-top:10px">A positive percentage means negative feedback decreased after resolution. A negative percentage means the problem worsened.</p><button class="btn" onclick="refreshResolution(${p.id})">Refresh measurement</button></div></div><div class="detail-section"><h3>Problem memory</h3><div class="card" style="padding:15px" id="problemMemory"><div class="sub">Loading historical interventions and similar cases…</div></div></div><div class="detail-section"><h3>Recommended next action</h3><div class="card" style="padding:15px"><b>${esc(p.recommended_action||'Review the evidence and assign an owner.')}</b><p class="sub" style="margin:7px 0 0">${esc(p.recommendation_reason||'Based on current problem signals.')}</p><button class="btn primary" style="margin-top:10px" onclick="addRecommendedAction(${p.id})">Create action</button></div></div><div class="detail-section"><h3>Lifecycle</h3><div style="display:flex;gap:5px;flex-wrap:wrap">${['detected','prioritized','assigned','acknowledged','investigating','action_taken','monitoring','resolved'].map(s=>`<button class="pill ${p.status===s?'monitoring':'status'}" onclick="updateStatus(${p.id},'${s}')">${s.replace('_',' ')}</button>`).join('')}</div></div><div class="detail-section"><h3>Customer evidence (${d.feedback.length})</h3>${d.feedback.slice(0,12).map(f=>`<div class="feedback-item"><span class="pill ${f.sentiment==='negative'?'high':'low'}">${esc(f.sentiment||'unclassified')}</span><p>${esc(f.message)}</p><div class="sub">${esc(f.source)} · similarity ${f.similarity_score!=null?Number(f.similarity_score).toFixed(2):'—'}</div></div>`).join('')||'<div class="empty">No linked feedback.</div>'}</div><div class="detail-section"><h3>Actions</h3><div style="display:flex;gap:8px;margin-bottom:10px"><button class="btn primary" onclick="addAction(${p.id})">Add action</button><button class="btn" onclick="recalculatePriority(${p.id})">Recalculate priority</button></div>${d.actions.map(a=>`<div class="info" style="margin-bottom:8px"><b>${esc(a.description)}</b><div class="sub">${esc(a.owner||'Unassigned')} · ${esc(a.status)}${a.completed_at?` · completed ${new Date(a.completed_at).toLocaleDateString()}`:''}</div>${a.reduction_percent!=null?`<div class="sub" style="margin-top:5px"><b>${a.reduction_percent>=0?'↓':'↑'} ${Math.abs(a.reduction_percent)}%</b> negative feedback vs the pre-action window</div>`:''}${a.expected_impact_percent!=null?`<div class="sub" style="margin-top:4px">Target ${Number(a.expected_impact_percent).toFixed(0)}% · <b>${esc(a.outcome_status||'not measured')}</b>${a.outcome_summary?` · ${esc(a.outcome_summary)}`:''}</div>`:''}<div style="margin-top:8px;display:flex;gap:5px">${a.status==='completed'?`<button class="pill status" onclick="measureAction(${a.id},${p.id})">Measure outcome</button>`:''}${['open','in_progress','completed'].map(st=>`<button class="pill ${a.status===st?'monitoring':'status'}" onclick="updateAction(${a.id},'${st}',${p.id})">${st.replace('_',' ')}</button>`).join('')}</div></div>`).join('')||'<div class="empty">No actions recorded yet.</div>'}</div><div class="detail-section"><h3>Problem trend</h3><div class="chart" style="height:150px" id="problemChart"></div></div>`;$('overlay').style.display='block';renderProblemChart(d.metrics||[]);loadProblemMemory(p.id)}catch(e){toast(e.message)}}
async function loadProblemMemory(id){try{const d=await api('/api/memory/problems/'+id);const mem=d.memory||{};const success=(mem.successful_interventions||[]).slice(0,3);const failed=(mem.failed_interventions||[]).slice(0,3);const similar=(d.similar_cases||[]).slice(0,3);$('problemMemory').innerHTML=`<div class="info-grid"><div class="info"><span>History</span><b>${mem.has_history?'Available':'No measured history'}</b></div><div class="info"><span>Resolution time</span><b>${mem.resolution_days!=null?mem.resolution_days+' days':'Not resolved'}</b></div></div><p style="margin:10px 0"><b>Lesson:</b> ${esc(mem.lesson||'Capture an outcome to create reusable memory.')}</p>${success.length?`<div style="margin-top:10px"><b>What worked</b>${success.map(a=>`<div class="sub" style="margin-top:5px">✓ ${esc(a.description)} · ${a.actual_impact_percent!=null?Number(a.actual_impact_percent).toFixed(1)+'% impact':''}</div>`).join('')}</div>`:''}${failed.length?`<div style="margin-top:10px"><b>Use caution</b>${failed.map(a=>`<div class="sub" style="margin-top:5px">! ${esc(a.description)} · ${a.actual_impact_percent!=null?Number(a.actual_impact_percent).toFixed(1)+'% impact':''}</div>`).join('')}</div>`:''}${similar.length?`<div style="margin-top:12px"><b>Similar cases</b>${similar.map(x=>`<div class="sub" style="margin-top:5px;cursor:pointer" onclick="openProblem(${Number(x.id)})">↳ Problem #${Number(x.id)} — ${esc(x.title)} · ${Math.round(Number(x.similarity)*100)}% language match</div>`).join('')}</div>`:''}`}catch(e){if($('problemMemory'))$('problemMemory').innerHTML='<div class="sub">Memory is not available yet.</div>'}}

async function saveProblemMeta(id){try{await api('/api/problems/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({owner:$('problemOwner').value.trim()||null,priority:$('problemPriority').value})});toast('Problem updated');await openProblem(id);loadOverview();loadProblems()}catch(e){toast(e.message)}}
async function addRecommendedAction(problemId){try{const d=await api('/api/problems/'+problemId);const p=d.problem;if(!p.recommended_action)return toast('No recommendation available');const owner=prompt('Owner (optional):',p.owner||p.recommended_team||'')||null;const target=prompt('Expected negative-feedback reduction %:','20');await api('/api/problems/'+problemId+'/actions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({description:p.recommended_action,owner,expected_impact_percent:target})});toast('Recommended action created');openProblem(problemId)}catch(e){toast(e.message)}}
async function addAction(problemId){const description=prompt('Describe the action to take:');if(!description?.trim())return;const owner=prompt('Owner (optional):')||null;const target=prompt('Expected negative-feedback reduction % (optional):','20');try{await api('/api/problems/'+problemId+'/actions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({description,owner,expected_impact_percent:target})});toast('Action added');openProblem(problemId)}catch(e){toast(e.message)}}
async function updateAction(id,status,problemId){try{await api('/api/actions/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status})});toast('Action updated');openProblem(problemId)}catch(e){toast(e.message)}}
async function measureAction(id,problemId){try{const d=await api('/api/actions/'+id+'/measure',{method:'POST'});toast(d.outcome?.summary||'Outcome measured');openProblem(problemId);loadOverview()}catch(e){toast(e.message)}}
$('measureAllBtn').onclick=async()=>{const b=$('measureAllBtn');b.disabled=true;b.textContent='Measuring…';try{const d=await api('/api/actions/measure-all',{method:'POST'});toast(`Measured ${d.measured} action outcomes`);loadOverview();loadProblems()}catch(e){toast(e.message)}finally{b.disabled=false;b.textContent='Measure outcomes'}};
async function refreshResolution(id){try{await api('/api/resolution/refresh',{method:'POST'});toast('Resolution measurement refreshed');await openProblem(id);loadOverview();loadProblems()}catch(e){toast(e.message)}}
async function recalculatePriority(id){try{const d=await api('/api/problems/recalculate-priorities',{method:'POST'});toast(`Priority updated for ${d.updated} problems`);openProblem(id);loadOverview();loadProblems()}catch(e){toast(e.message)}}
async function updateStatus(id,status){try{await api('/api/problems/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status})});toast('Problem updated');openProblem(id);loadOverview()}catch(e){toast(e.message)}}
function closeDrawer(){$('overlay').style.display='none'}$('overlay').onclick=e=>{if(e.target===$('overlay'))closeDrawer()};
function renderChart(rows){const el=$('healthChart');const byDate={};(rows||[]).forEach(r=>byDate[String(r.date).slice(0,10)]=Number(r.negative_count||0));const vals=[];const labels=[];for(let i=13;i>=0;i--){const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()-i);const key=d.toISOString().slice(0,10);labels.push(d.toLocaleDateString(undefined,{month:'short',day:'numeric'}));vals.push(byDate[key]||0)}const max=Math.max(1,...vals);const w=620,h=170,p=12;const pts=vals.map((v,i)=>[(p+i*(w-2*p)/(vals.length-1)),h-p-(v/max)*(h-2*p)]);const line=pts.map((x,i)=>(i?'L':'M')+x[0].toFixed(1)+' '+x[1].toFixed(1)).join(' ');const area=line+` L ${pts.at(-1)[0]} ${h-p} L ${pts[0][0]} ${h-p} Z`;el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none"><line class="axis" x1="12" y1="35" x2="608" y2="35"/><line class="axis" x1="12" y1="82" x2="608" y2="82"/><line class="axis" x1="12" y1="129" x2="608" y2="129"/><path class="area" d="${area}"/><path class="line" d="${line}"/>${pts.filter((_,i)=>i%3===0||i===pts.length-1).map((x,i)=>`<circle class="dot" cx="${x[0]}" cy="${x[1]}" r="3.5"/>`).join('')}</svg><div class="sub" style="display:flex;justify-content:space-between;margin-top:-3px"><span>${labels[0]}</span><span>${labels[7]}</span><span>${labels[13]}</span></div>`}
function renderProblemChart(rows){const el=$('problemChart');if(!el)return;const vals=(rows||[]).slice(-14).map(r=>Number(r.negative_count||0));if(!vals.length){el.innerHTML='<div class="empty">No trend data yet.</div>';return}const max=Math.max(1,...vals),w=620,h=140,p=10;const pts=vals.map((v,i)=>[(p+i*(w-2*p)/Math.max(1,vals.length-1)),h-p-(v/max)*(h-2*p)]);const line=pts.map((x,i)=>(i?'L':'M')+x[0].toFixed(1)+' '+x[1].toFixed(1)).join(' ');el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none"><path class="line" d="${line}"/>${pts.map(x=>`<circle class="dot" cx="${x[0]}" cy="${x[1]}" r="3"/>`).join('')}</svg>`}

async function loadInvestigation(){try{const d=await api('/api/prevention');const items=(d.items||[]).slice(0,10);$('investigationQueue').innerHTML=items.length?items.map(x=>`<div class="priority-item"><div class="priority-top"><span class="priority-rank">Risk ${Number(x.risk_score||0).toFixed(0)}</span><span class="pill ${x.risk_score>=80?'critical':x.risk_score>=60?'high':'medium'}">${esc(x.problem.priority||'medium')}</span></div><h3>${esc(x.problem.title)}</h3><div class="sub">${Number(x.problem.feedback_count||0)} reports · ${esc(x.problem.health||'Unknown')} · ${esc(x.suggested_action)}</div><div style="margin-top:8px;display:flex;gap:6px"><button class="pill monitoring" onclick="inspectPrediction(${x.problem.id})">Prediction</button><button class="pill status" onclick="openProblem(${x.problem.id})">Open problem</button></div></div>`).join(''):'<div class="empty">No open problems.</div>';const top=items[0];$('predictionSummary').innerHTML=top?`<div class="info-grid"><div class="info"><span>Top risk</span><b>${Number(top.risk_score).toFixed(0)}/100</b></div><div class="info"><span>Expected impact</span><b>${Number(top.expected_impact||0)}%</b></div></div><p class="sub" style="margin-top:12px">Run the intelligence loop to refresh root-cause evidence, 7-day forecasts, and preventive recommendations.</p>`:'<div class="empty">No predictive signals yet.</div>'}catch(e){$('investigationQueue').innerHTML='<div class="empty">Unable to load investigation queue.</div>'}}
async function inspectPrediction(id){try{const d=await api('/api/problems/'+id+'/prediction');alert(`Risk ${d.risk_score}/100 (${d.risk_level})\nTrend: ${d.trend}\n7-day forecast: ${d.forecast_7d}\nComparable action success forecast: ${d.action_success_forecast}%\n\n${d.explanation}`)}catch(e){toast(e.message)}}
async function runUnifiedLoop(){try{const d=await api('/api/operations/run',{method:'POST'});toast(`Loop complete · ${d.processed} problems processed`);loadInvestigation();loadPrevention();loadOverview()}catch(e){toast(e.message)}}
async function refreshRootCauses(){try{const d=await api('/api/intelligence/root-cause/refresh',{method:'POST'});toast(`Root causes refreshed for ${d.refreshed} problems`);loadInvestigation()}catch(e){toast(e.message)}}
async function loadPrevention(){try{const d=await api('/api/prevention');$('preventionQueue').innerHTML=(d.items||[]).length?(d.items||[]).map(x=>`<div class="priority-item"><div class="priority-top"><span class="priority-rank">${Number(x.risk_score||0).toFixed(0)} risk</span><span class="pill ${x.risk_score>=80?'critical':x.risk_score>=60?'high':'medium'}">${esc(x.problem.priority||'medium')}</span></div><h3>${esc(x.problem.title)}</h3><div class="sub">Owner: ${esc(x.owner||'Unassigned')} · Expected impact ${Number(x.expected_impact||0)}%</div><p style="margin:8px 0">${esc(x.suggested_action)}</p><button class="btn primary" onclick="createPreventive(${x.problem.id},${JSON.stringify(x.suggested_action).replace(/</g,'\\u003c')})">Approve preventive action</button></div>`).join(''):'<div class="empty">No preventive recommendations yet. Run the intelligence loop.</div>'}catch(e){$('preventionQueue').innerHTML='<div class="empty">Unable to load preventive queue.</div>'}}
async function createPreventive(problemId,title){try{await api('/api/prevention',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({problem_id:problemId,title,description:title,expected_impact:20})});toast('Preventive action created');loadPrevention()}catch(e){toast(e.message)}}
async function createInitiative(themeId,themeName){try{const r=await api('/api/strategy/themes/'+themeId+'/initiative-recommendation',{method:'POST'});const owner=prompt('Owner (optional):')||null;const effort=prompt('Effort points:','5');const cap=prompt('Available capacity:','5');const risk=prompt('Execution risk %:','40');await api('/api/strategy/themes/'+themeId+'/initiatives',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...r,title:prompt('Initiative title:',r.title||`Improve ${themeName}`)||r.title,owner,effort_points:Number(effort||5),capacity_available:Number(cap||0),execution_risk:Number(risk||40)})});toast('Initiative created');loadStrategy()}catch(e){toast(e.message)}}
async function recommendThemes(){try{const d=await api('/api/strategy/themes/recommend',{method:'POST'});for(const x of d){await api('/api/strategy/themes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(x)})}toast(`${d.length} strategic themes created`);loadStrategy()}catch(e){toast(e.message)}}
async function loadStrategy(){try{const [t,p]=await Promise.all([api('/api/strategy/themes'),api('/api/portfolio')]);$('strategyThemes').innerHTML=t.length?t.map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.name)}</b><span class="pill">${esc(x.priority)}</span></div><div class="sub">${Number(x.problems||0)} problems · ${Number(x.initiatives||0)} initiatives</div><div style="margin-top:8px"><button class="pill monitoring" onclick="createInitiative(${x.id},${JSON.stringify(x.name).replace(/</g,'\u003c')})">Create initiative</button></div></div>`).join(''):'<div class="empty">No themes yet. Click Recommend themes.</div>';$('portfolioQueue').innerHTML=p.items.length?p.items.map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.title)}</b><span class="pill">${esc(x.decision||'defer').replace('_',' ')}</span></div><div class="sub">Value ${Number(x.value||0).toFixed(0)} · ${Number(x.efficiency||0).toFixed(1)}/effort · ${Number(x.target_impact||0)}% target</div></div>`).join(''):'<div class="empty">Create initiatives under a strategic theme to populate the portfolio.</div>'}catch(e){$('strategyThemes').innerHTML='<div class="empty">Unable to load strategy.</div>'}}
async function rebalancePortfolio(){try{const d=await api('/api/portfolio/rebalance',{method:'POST'});toast(`Portfolio reviewed · ${d.fund_now} fund now · ${d.sequence} sequence · ${d.defer} defer`);loadStrategy()}catch(e){toast(e.message)}}
async function saveStrategySnapshot(){try{const p=await api('/api/portfolio');await api('/api/strategy/snapshot',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:'FeedbackOS Operating Snapshot '+new Date().toLocaleString(),summary:`${p.fund_now} fund now, ${p.sequence} sequence, ${p.defer} defer; expected impact ${Number(p.expected_impact||0).toFixed(0)}%.`})});toast('Snapshot saved')}catch(e){toast(e.message)}}

async function loadJourney(){try{const d=await api('/api/journey/overview');const s=d.summary||{};$('journeyFeedback').textContent=Number(s.total_feedback||0);$('journeyCustomers').textContent=Number(s.customers||0);$('journeyNegative').textContent=Number(s.negative_feedback||0);$('journeyRisk').textContent=Number(s.at_risk_stages||0);$('journeyStages').innerHTML=(d.stages||[]).map(x=>`<div class="priority-item" style="margin-bottom:8px;cursor:pointer" onclick="inspectJourneyStage('${x.stage}')"><div class="priority-top"><b>${esc(x.stage)}</b><span class="pill ${x.health==='At risk'?'critical':x.health==='Watch'?'medium':'low'}">${esc(x.health)}</span></div><div class="sub">${Number(x.feedback_count)} reports · ${Number(x.negative_count)} negative · ${Number(x.negative_rate).toFixed(1)}% negative · ${Number(x.customers)} customers</div></div>`).join('')||'<div class="empty">No journey data yet.</div>';$('journeyCustomersList').innerHTML=(d.customers||[]).map(x=>`<div class="priority-item" style="margin-bottom:8px;cursor:pointer" onclick="inspectJourneyCustomer(${JSON.stringify(x.customer).replace(/</g,'\u003c')})"><div class="priority-top"><b>${esc(x.customer)}</b><span class="pill ${x.health==='At risk'?'critical':x.health==='Watch'?'medium':'low'}">${esc(x.health)}</span></div><div class="sub">${Number(x.feedback_count)} reports · ${Number(x.negative_count)} negative · ${Number(x.negative_rate).toFixed(1)}% negative · ${Number(x.stages)} stages</div></div>`).join('')||'<div class="empty">No named customers yet.</div>'}catch(e){toast(e.message)}}
async function classifyJourney(){try{const d=await api('/api/journey/classify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({limit:1000})});toast(`Journey classified ${Number(d.updated||0)} feedback records`);loadJourney()}catch(e){toast(e.message)}}
async function inspectJourneyCustomer(name){try{const d=await api('/api/journey/customers/'+encodeURIComponent(name));const s=d.summary;$('journeyDetail').innerHTML=`<div class="info-grid"><div class="info"><span>Customer</span><b>${esc(s.customer)}</b></div><div class="info"><span>Journey stages</span><b>${Number(s.stages)}</b></div><div class="info"><span>Negative rate</span><b>${Number(s.negative_rate).toFixed(1)}%</b></div><div class="info"><span>Health</span><b>${esc(s.health)}</b></div></div><div class="detail-section"><h3>Experience timeline</h3><div class="timeline">${(d.timeline||[]).map(x=>`<div class="timeline-item"><div class="timeline-dot"></div><div><div class="timeline-date">${new Date(x.date).toLocaleString()} · ${esc(x.stage)}${x.sentiment?` · ${esc(x.sentiment)}`:''}</div><div class="timeline-label">${esc(x.message)}</div></div></div>`).join('')}</div></div><div class="detail-section"><h3>Stage summary</h3>${(d.stageCounts||[]).map(x=>`<div class="sub" style="margin:7px 0"><b>${esc(x.stage)}</b> · ${Number(x.count)} reports · ${Number(x.negative)} negative</div>`).join('')}</div>`}catch(e){toast(e.message)}}
async function inspectJourneyStage(stage){try{const d=await api('/api/journey/stages/'+encodeURIComponent(stage));$('journeyDetail').innerHTML=`<div class="info-grid"><div class="info"><span>Stage</span><b>${esc(d.stage)}</b></div><div class="info"><span>Reports</span><b>${Number(d.feedback_count)}</b></div><div class="info"><span>Negative</span><b>${Number(d.negative_count)}</b></div></div><div class="detail-section"><h3>Recent evidence</h3>${(d.feedback||[]).slice(0,30).map(f=>`<div class="feedback-item"><div class="sub">${new Date(f.created_at).toLocaleString()} · ${esc(f.customer_name||'Anonymous')} · ${esc(f.source||'')}</div><p>${esc(f.message)}</p><span class="pill ${f.sentiment==='negative'?'high':f.sentiment==='positive'?'low':'status'}">${esc(f.sentiment||'unclassified')}</span></div>`).join('')||'<div class="empty">No feedback for this stage.</div>'}</div>`}catch(e){toast(e.message)}}

async function loadSegments(){try{const d=await api('/api/segments/overview');const s=d.summary||{};$('segFeedback').textContent=Number(s.total_feedback||0);$('segCustomers').textContent=Number(s.named_customers||0);$('segNegative').textContent=Number(s.negative_feedback||0);const risky=(d.customers||[]).filter(x=>x.health==='At risk');$('segRisk').textContent=risky.length;
 $('segmentCustomersTable').innerHTML=(d.customers||[]).length?`<table class="table"><thead><tr><th>Customer</th><th>Reports</th><th>Negative</th><th>Health</th></tr></thead><tbody>${d.customers.map(x=>`<tr onclick="inspectCustomer(${JSON.stringify(x.customer).replace(/</g,'\\u003c')})" style="cursor:pointer"><td><b>${esc(x.customer)}</b></td><td>${Number(x.feedback_count)}</td><td>${Number(x.negative_count)} (${Number(x.negative_rate).toFixed(1)}%)</td><td><span class="pill ${x.health==='At risk'?'critical':x.health==='Watch'?'medium':'low'}">${esc(x.health)}</span></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No named customers yet.</div>';
 $('segmentCategories').innerHTML=(d.categories||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.segment)}</b><span class="pill ${x.health==='At risk'?'critical':x.health==='Watch'?'medium':'low'}">${esc(x.health)}</span></div><div class="sub">${Number(x.feedback_count)} reports · ${Number(x.negative_count)} negative · ${Number(x.negative_rate).toFixed(1)}% negative</div></div>`).join('')||'<div class="empty">No categories yet.</div>';
 $('segmentSources').innerHTML=(d.sources||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.segment)}</b><span class="pill ${x.health==='At risk'?'critical':x.health==='Watch'?'medium':'low'}">${esc(x.health)}</span></div><div class="sub">${Number(x.feedback_count)} reports · ${Number(x.negative_count)} negative · ${Number(x.customers)} customers</div></div>`).join('')||'<div class="empty">No sources yet.</div>';
 }catch(e){$('customerDetail').innerHTML='<div class="empty">Unable to load segment intelligence.</div>';toast(e.message)}}
async function inspectCustomer(name){try{const d=await api('/api/customers/'+encodeURIComponent(name));const s=d.summary;$('customerDetail').innerHTML=`<div class="info-grid"><div class="info"><span>Customer</span><b>${esc(s.customer)}</b></div><div class="info"><span>Feedback</span><b>${Number(s.feedback_count)}</b></div><div class="info"><span>Negative rate</span><b>${Number(s.negative_rate).toFixed(1)}%</b></div><div class="info"><span>Linked problems</span><b>${Number(s.problems)}</b></div></div><div class="detail-section"><h3>Linked problems</h3>${(d.problems||[]).map(p=>`<div class="priority-item" style="cursor:pointer" onclick="openProblem(${Number(p.id)})"><div class="priority-top"><b>${esc(p.title)}</b><span class="pill ${p.priority||'medium'}">${esc(p.priority||'medium')}</span></div><div class="sub">${Number(p.feedback_count||0)} reports · ${esc(p.status||'')}</div></div>`).join('')||'<div class="empty">No linked problems.</div>'}</div><div class="detail-section"><h3>Recent feedback</h3>${(d.feedback||[]).slice(0,10).map(f=>`<div class="feedback-item"><div class="sub">${new Date(f.created_at).toLocaleDateString()} · ${esc(f.category||'Uncategorized')}</div><p>${esc(f.message)}</p><span class="pill ${f.sentiment==='negative'?'high':f.sentiment==='positive'?'low':'status'}">${esc(f.sentiment||'unclassified')}</span></div>`).join('')||'<div class="empty">No feedback.</div>'}</div>`}catch(e){toast(e.message)}}

async function classifyFeatures(){try{const d=await api('/api/features/classify',{method:'POST'});toast(`Classified ${d.updated} feedback items`);await loadFeatures()}catch(e){toast(e.message)}}
async function loadFeatures(){try{const d=await api('/api/features/overview');const s=d.summary||{};$('featureCount').textContent=Number(s.features||0);$('featureFeedback').textContent=Number(s.feedback||0);$('featureNegative').textContent=Number(s.negative||0);const items=d.items||[];$('featureRisk').textContent=items.filter(x=>x.risk==='High').length;
 $('featureTable').innerHTML=items.length?`<table class="table"><thead><tr><th>Feature</th><th>Area</th><th>Reports</th><th>Negative rate</th><th>7d change</th><th>Risk</th></tr></thead><tbody>${items.map(x=>`<tr onclick="inspectFeature(${JSON.stringify(x.feature_name).replace(/</g,'\u003c')})" style="cursor:pointer"><td><b>${esc(x.feature_name)}</b></td><td>${esc(x.product_area)}</td><td>${Number(x.feedback_count)}</td><td>${Number(x.negative_rate||0).toFixed(1)}%</td><td>${Number(x.risk_change_percent||0)>0?'↑ ':'↓ '}${Math.abs(Number(x.risk_change_percent||0)).toFixed(1)}%</td><td><span class="pill ${x.risk==='High'?'critical':x.risk==='Watch'?'medium':'low'}">${x.risk}</span></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No feature signals yet. Click Classify feedback.</div>';
 const areas={};items.forEach(x=>{const a=x.product_area||'Other';areas[a]??={feedback:0,negative:0,features:0};areas[a].feedback+=Number(x.feedback_count||0);areas[a].negative+=Number(x.negative_count||0);areas[a].features++});$('productAreas').innerHTML=Object.entries(areas).sort((a,b)=>(b[1].negative/b[1].feedback)-(a[1].negative/a[1].feedback)).map(([a,v])=>`<div class="priority-item"><div class="priority-top"><b>${esc(a)}</b><span class="pill ${v.negative/v.feedback>=.6?'critical':v.negative/v.feedback>=.3?'medium':'low'}">${(v.negative/v.feedback*100).toFixed(1)}%</span></div><div class="sub">${v.features} features · ${v.feedback} reports · ${v.negative} negative</div></div>`).join('')||'<div class="empty">No product areas yet.</div>';
 }catch(e){toast(e.message)}}
async function inspectFeature(name){try{const d=await api('/api/features/'+encodeURIComponent(name));const s=d.summary||{};$('featureDetail').innerHTML=`<div class="info-grid"><div class="info"><span>Feature</span><b>${esc(d.feature)}</b></div><div class="info"><span>Feedback</span><b>${Number(s.feedback_count||0)}</b></div><div class="info"><span>Negative rate</span><b>${(Number(s.negative_count||0)/Math.max(1,Number(s.feedback_count||0))*100).toFixed(1)}%</b></div><div class="info"><span>Customers</span><b>${Number(s.customers||0)}</b></div></div><div class="detail-section"><h3>Linked problems</h3>${(d.problems||[]).map(p=>`<div class="priority-item" style="cursor:pointer" onclick="openProblem(${Number(p.id)})"><div class="priority-top"><b>${esc(p.title)}</b><span class="pill ${p.priority||'medium'}">${esc(p.priority||'medium')}</span></div><div class="sub">${Number(p.feedback_count||0)} reports · ${esc(p.status||'')}</div></div>`).join('')||'<div class="empty">No linked problems.</div>'}</div><div class="detail-section"><h3>Recent feedback</h3>${(d.feedback||[]).slice(0,8).map(f=>`<div class="feedback-item"><div class="sub">${new Date(f.created_at).toLocaleDateString()} · ${esc(f.customer_name||'Unknown customer')}</div><p>${esc(f.message)}</p><span class="pill ${f.sentiment==='negative'?'high':f.sentiment==='positive'?'low':'status'}">${esc(f.sentiment||'unclassified')}</span></div>`).join('')||'<div class="empty">No feedback.</div>'}</div>`}catch(e){toast(e.message)}}



async function loadExecutive(){
 try{
  const d=await api('/api/executive/overview'),o=d.overview||{},p=d.portfolio||{},a=d.automation||{};
  $('execHealth').textContent=Number(o.health_score||0);
  $('execHealthLabel').textContent=esc(o.health_label||'');
  $('execNegative').textContent=Number(o.negative||0);
  $('execNegativeChange').textContent=(Number(o.negative_change||0)>0?'↑ ':'↓ ')+Math.abs(Number(o.negative_change||0))+'% vs previous 7d';
  $('execHigh').textContent=Number(o.high||0); $('execCustomers').textContent=Number(o.customers||0); $('execAutomation').textContent=Number(a.pending||0);
  $('execAttention').innerHTML=(d.attention||[]).map(x=>`<div class="priority-item" style="margin:8px 18px;cursor:pointer" onclick="openProblem(${Number(x.id)})"><div class="priority-top"><b>${esc(x.title)}</b><span class="pill ${x.attention_level==='Critical'?'critical':x.attention_level==='High'?'high':x.attention_level==='Watch'?'medium':'low'}">${esc(x.attention_level)}</span></div><div class="sub">${Number(x.feedback_count||0)} reports · ${esc(x.priority||'medium')} priority · Owner: ${esc(x.owner||'Unassigned')}</div></div>`).join('')||'<div class="empty">No active risks detected.</div>';
  $('execImpact').innerHTML=(d.impact||[]).slice(0,8).map(x=>`<div class="priority-item" style="margin:8px 18px"><div class="priority-top"><b>${esc(x.category)}</b><span class="pill ${Number(x.negative_rate)>=60?'critical':Number(x.negative_rate)>=30?'medium':'low'}">${Number(x.negative_rate).toFixed(1)}%</span></div><div class="sub">${Number(x.feedback_count)} reports · ${Number(x.negative_count)} negative · ${Number(x.customers)} customers</div></div>`).join('')||'<div class="empty">No impact signals yet.</div>';
  $('execPortfolio').innerHTML=`<div class="info-grid"><div class="info"><span>Active initiatives</span><b>${Number(p.active||0)}</b></div><div class="info"><span>Fund Now</span><b>${Number(p.fund_now||0)}</b></div><div class="info"><span>Sequence</span><b>${Number(p.sequence||0)}</b></div><div class="info"><span>Defer</span><b>${Number(p.defer||0)}</b></div></div>`;
  const top=(d.attention||[])[0], guidance=top?`<div class="intel-next"><b>Highest priority</b>${esc(top.title)} — ${Number(top.feedback_count||0)} linked reports and ${esc(top.priority||'medium')} priority.</div>`:'<div class="empty">No immediate intervention required.</div>';
  $('execGuidance').innerHTML=guidance+`<div class="sub" style="margin-top:12px">${Number(a.approved||0)} automation items approved and awaiting completion. Review them in Automation.</div>`;
  const snaps=await api('/api/executive/snapshots');$('execSnapshots').innerHTML=(snaps.items||[]).map(x=>`<div class="priority-item" style="margin:8px 18px"><div class="priority-top"><b>${esc(x.title)}</b><span class="sub">${new Date(x.created_at).toLocaleString()}</span></div><div class="sub">${esc(x.summary||'')}</div></div>`).join('')||'<div class="empty">No snapshots saved yet.</div>';
 }catch(e){toast(e.message)}
}
async function saveExecutiveSnapshot(){
 try{const d=await api('/api/executive/overview');const top=(d.attention||[])[0];const summary=`Health ${Number(d.overview?.health_score||0)}. Negative feedback ${Number(d.overview?.negative||0)} (${Number(d.overview?.negative_change||0)}% week over week). ${top?'Top attention: '+top.title+'.':'No immediate top problem.'}`;await api('/api/executive/snapshot',{method:'POST',body:JSON.stringify({title:'Executive Snapshot',summary})});toast('Executive snapshot saved');loadExecutive()}catch(e){toast(e.message)}
}

async function loadTeams(){try{
 const d=await api('/api/teams/overview');const s=d.summary||{};
 $('teamOpenProblems').textContent=Number(s.open_problems||0);
 $('teamHighPriority').textContent=Number(s.high_priority||0);
 $('teamUnowned').textContent=Number(s.unowned_problems||0);
 $('teamOpenActions').textContent=Number(s.open_actions||0);
 const teams=d.teams||[];
 $('teamTable').innerHTML=teams.length?`<table class="table"><thead><tr><th>Team</th><th>Open problems</th><th>High priority</th><th>Open actions</th><th>Feedback impact</th><th>Load</th><th>Accountability</th></tr></thead><tbody>${teams.map(x=>`<tr onclick="inspectTeam(${JSON.stringify(x.team).replace(/</g,'\\u003c')})" style="cursor:pointer"><td><b>${esc(x.team)}</b></td><td>${Number(x.open_problems||0)}</td><td>${Number(x.high_priority||0)}</td><td>${Number(x.open_actions||0)}</td><td>${Number(x.feedback_count||0)}</td><td>${Number(x.load_score||0)}/100</td><td><span class="pill ${x.accountability==='Needs owner'||x.accountability==='Action gap'?'critical':x.accountability==='Overloaded'?'medium':'low'}">${esc(x.accountability)}</span></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No team ownership signals yet.</div>';
 const owners=await api('/api/owners/overview');
 $('ownerTable').innerHTML=(owners.owners||[]).length?`<table class="table"><thead><tr><th>Owner</th><th>Open</th><th>High</th><th>Feedback</th></tr></thead><tbody>${owners.owners.map(x=>`<tr><td><b>${esc(x.owner)}</b></td><td>${Number(x.open_problems||0)}</td><td>${Number(x.high_priority||0)}</td><td>${Number(x.feedback_count||0)}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No owners yet.</div>';
}catch(e){toast(e.message)}}
async function runAutomation(){try{const d=await api('/api/automation/run',{method:'POST'});toast(`Automation created ${Number(d.created||0)} review items`);await loadAutomation()}catch(e){toast(e.message)}}
async function updateAutomationItem(id,status){try{await api('/api/automation/queue/'+id,{method:'PATCH',body:JSON.stringify({status})});await loadAutomation()}catch(e){toast(e.message)}}
async function loadAutomation(){try{const d=await api('/api/automation/overview');const r=d.rules||{},q=d.queue||{};$('autoRules').textContent=Number(r.enabled||0);$('autoPending').textContent=Number(q.pending||0);$('autoApproved').textContent=Number(q.approved||0);$('autoCompleted').textContent=Number(q.completed||0);
 $('automationQueue').innerHTML=(d.items||[]).length?d.items.map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.title)}</b><span class="pill ${x.status==='pending'?'medium':x.status==='approved'?'low':x.status==='dismissed'?'status':'low'}">${esc(x.status)}</span></div><div class="sub">${esc(x.rule_name||'Automation rule')} · ${new Date(x.created_at).toLocaleString()}</div><p style="margin:8px 0">${esc(x.description||'')}</p><div class="toolbar">${x.status==='pending'?`<button class="btn" onclick="updateAutomationItem(${Number(x.id)},'approved')">Approve</button><button class="btn" onclick="updateAutomationItem(${Number(x.id)},'dismissed')">Dismiss</button>`:''}${x.status==='approved'?`<button class="btn primary" onclick="updateAutomationItem(${Number(x.id)},'completed')">Mark completed</button>`:''}</div></div>`).join(''):'<div class="empty">No automation review items yet. Run automation to evaluate the active rules.</div>';
 $('automationRules').innerHTML=(d.items&&d.rules?[]:[]);
 const rr=await api('/api/automation/overview');
 const ruleRows=rr.rules_list||[];
 $('automationRules').innerHTML=ruleRows.length?ruleRows.map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.name)}</b><span class="pill ${x.enabled?'low':'status'}">${x.enabled?'enabled':'disabled'}</span></div><div class="sub">${esc(x.rule_type)} · threshold ${Number(x.threshold||0)}</div><div class="sub" style="margin-top:4px">${esc(x.description||'')}</div></div>`).join(''):'<div class="empty">No rules configured.</div>';
 $('automationRuns').innerHTML=(d.runs||[]).length?d.runs.map(x=>`<div class="priority-item"><div class="priority-top"><b>Run #${Number(x.id)}</b><span class="pill status">${esc(x.trigger_type)}</span></div><div class="sub">${new Date(x.created_at).toLocaleString()} · ${Number(x.rules_evaluated)} rules · ${Number(x.items_created)} created · ${Number(x.items_skipped)} skipped</div><div class="sub">${esc(x.summary||'')}</div></div>`).join(''):'<div class="empty">No automation runs yet.</div>';
 }catch(e){toast(e.message)}}

async function inspectTeam(name){try{const d=await api('/api/teams/'+encodeURIComponent(name));
 $('teamDetail').innerHTML=`<div class="detail-section"><h3>${esc(d.team)}</h3><div class="sub">${(d.problems||[]).length} problems · ${(d.actions||[]).length} actions</div></div><div class="detail-section"><h3>Problems</h3>${(d.problems||[]).map(p=>`<div class="priority-item" style="cursor:pointer" onclick="openProblem(${Number(p.id)})"><div class="priority-top"><b>${esc(p.title)}</b><span class="pill ${p.priority||'medium'}">${esc(p.priority||'medium')}</span></div><div class="sub">${Number(p.feedback_count||0)} reports · ${esc(p.status||'')} · Owner: ${esc(p.owner||'Unassigned')}</div></div>`).join('')||'<div class="empty">No problems.</div>'}</div><div class="detail-section"><h3>Actions</h3>${(d.actions||[]).map(a=>`<div class="priority-item"><div class="priority-top"><b>${esc(a.description||'Action')}</b><span class="pill ${a.status==='completed'?'low':a.status==='in_progress'?'medium':'status'}">${esc(a.status||'open')}</span></div><div class="sub">Owner: ${esc(a.owner||'Unassigned')}${a.actual_impact_percent!=null?' · Actual impact: '+Number(a.actual_impact_percent).toFixed(1)+'%':''}</div></div>`).join('')||'<div class="empty">No actions.</div>'}</div>`;
}catch(e){toast(e.message)}}

async function loadOS(){try{const d=await api('/api/os/overview');$('osHealth').textContent=Number(d.health_score||0);$('osHealthLabel').textContent=d.health_label||'';$('osProblems').textContent=Number(d.problems?.active||0);$('osHigh').textContent=Number(d.problems?.high||0)+' high priority · '+Number(d.problems?.unowned||0)+' unowned';$('osActions').textContent=Number(d.actions?.open||0);$('osPending').textContent=Number((await api('/api/os/queue')).counts?.proposed||0);$('osRisk').textContent=Math.round(Number(d.prediction?.avg_risk||0));$('osCoverage').innerHTML=`<div class="info-grid"><div class="info"><span>Feedback mapped to journey</span><b>${Number(d.journey?.mapped||0)}</b></div><div class="info"><span>Feedback mapped to features</span><b>${Number(d.features?.mapped||0)}</b></div><div class="info"><span>Active initiatives</span><b>${Number(d.strategy?.active_initiatives||0)}</b></div><div class="info"><span>Customers</span><b>${Number(d.customers||0)}</b></div></div>`;const a=await api('/api/os/attention');$('osAttention').innerHTML=(a.items||[]).map(x=>`<div class="priority-item" style="margin:8px 18px;cursor:pointer" onclick="openProblem(${Number(x.id)})"><div class="priority-top"><b>${esc(x.title)}</b><span class="pill ${x.attention_level==='Critical'?'critical':x.attention_level==='High'?'high':x.attention_level==='Watch'?'medium':'low'}">${esc(x.attention_level)}</span></div><div class="sub">Score ${Number(x.attention_score)} · ${Number(x.feedback_count||0)} reports · ${esc(x.owner||'Unassigned')}</div><div class="decision-action">Next: ${esc(x.next_action)}</div></div>`).join('')||'<div class="empty">No immediate intervention required.</div>';const q=await api('/api/os/queue');$('osQueue').innerHTML=(q.items||[]).map(x=>`<div class="priority-item" style="margin:8px 18px"><div class="priority-top"><b>${esc(x.title)}</b><span class="pill ${x.status==='approved'?'low':'medium'}">${esc(x.status)}</span></div><div class="sub">Score ${Number(x.score)} · ${esc(x.priority)} priority · ${new Date(x.created_at).toLocaleString()}</div><p>${esc(x.next_action||'Review evidence')}</p><div class="toolbar">${x.status==='proposed'?`<button class="btn" onclick="updateOSDecision(${x.id},'approved')">Approve</button><button class="btn" onclick="updateOSDecision(${x.id},'dismissed')">Dismiss</button>`:''}${x.status==='approved'?`<button class="btn primary" onclick="updateOSDecision(${x.id},'completed')">Mark completed</button>`:''}</div></div>`).join('')||'<div class="empty">Run the operating loop to generate governed decisions.</div>';const sn=await api('/api/os/snapshots');$('osSnapshots').innerHTML=(sn.items||[]).map(x=>`<div class="priority-item" style="margin:8px 18px"><div class="priority-top"><b>${esc(x.title)}</b><span class="sub">Health ${Number(x.health_score)}</span></div><div class="sub">${new Date(x.created_at).toLocaleString()}</div><p>${esc(x.summary||'')}</p></div>`).join('')||'<div class="empty">No operating snapshots yet.</div>'}catch(e){toast(e.message)}}
async function runOSLoop(){try{const d=await api('/api/os/run',{method:'POST'});toast(`Operating loop created ${Number(d.items?.length||0)} decisions`);loadOS()}catch(e){toast(e.message)}}
async function updateOSDecision(id,status){try{await api('/api/os/decisions/'+id,{method:'PATCH',body:JSON.stringify({status,reviewed_by:'human'})});toast('Decision updated');loadOS()}catch(e){toast(e.message)}}
async function saveOSSnapshot(){try{const d=await api('/api/os/overview');await api('/api/os/snapshot',{method:'POST',body:JSON.stringify({title:'FeedbackOS Operating Snapshot',summary:`Health ${d.health_score}. ${d.problems.active} active problems, ${d.actions.open} open actions, ${d.prediction.signals} recent predictive signals.`})});toast('Operating snapshot saved');loadOS()}catch(e){toast(e.message)}}


async function loadSaaSOps(){
 try{
  const d=await api('/api/ops/status');
  $('opsStatus').textContent=d.status; $('opsStatus').className='value '+(d.status==='healthy'?'ok':d.status==='critical'?'bad':'');
  $('opsStatusSub').textContent=`Uptime ${Number(d.uptime_seconds||0)}s · checked ${new Date(d.checked_at).toLocaleTimeString()}`;
  $('opsDb').textContent=d.database.ok?`${Number(d.database.latency_ms||0)} ms`:'DOWN'; $('opsDb').className='value '+(d.database.ok?'ok':'bad');
  $('opsErrors').textContent=(Number(d.api.error_rate||0)*100).toFixed(2)+'%'; $('opsErrorsSub').textContent=`${Number(d.api.errors_24h||0)} errors / ${Number(d.api.requests_24h||0)} requests`;
  $('opsLatency').textContent=Number(d.api.avg_latency_ms||0).toFixed(1)+' ms'; $('opsIngest').textContent=Number(d.ingestion.failures_24h||0);
  const m=await api('/api/ops/metrics'); $('opsMetrics').innerHTML=`<table class="ops-table"><thead><tr><th>Route</th><th>Requests</th><th>Errors</th><th>Avg</th></tr></thead><tbody>`+(m.items||[]).map(x=>`<tr><td>${esc(x.method)} ${esc(x.route)}</td><td>${Number(x.requests)}</td><td class="${Number(x.errors)?'bad':'ok'}">${Number(x.errors||0)}</td><td>${Number(x.avg_ms||0).toFixed(1)} ms</td></tr>`).join('')+'</tbody></table>' || '<div class="empty">No API metrics yet.</div>';
  const ing=await api('/api/ops/ingestion'); $('opsIngestion').innerHTML=(ing.items||[]).slice(0,10).map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.source)}</b><span class="pill ${x.status==='failed'?'critical':'low'}">${esc(x.status)}</span></div><div class="sub">${Number(x.feedback_count||0)} feedback · ${new Date(x.created_at).toLocaleString()}</div>${x.error_message?`<div class="sub bad">${esc(x.error_message)}</div>`:''}</div>`).join('')||'<div class="empty">No ingestion events yet.</div>';
  const jobs=await api('/api/ops/jobs'); $('opsJobs').innerHTML=(jobs.items||[]).slice(0,15).map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.job_name)}</b><span class="pill ${x.status==='failed'?'critical':x.status==='completed'?'low':'medium'}">${esc(x.status)}</span></div><div class="sub">${new Date(x.started_at).toLocaleString()} · ${x.duration_ms!=null?Number(x.duration_ms)+' ms':''}</div></div>`).join('')||'<div class="empty">No job runs yet.</div>';
 }catch(e){toast(e.message)}
}
async function runOpsDiagnostic(){try{await api('/api/ops/jobs/diagnostic',{method:'POST',body:JSON.stringify({job_name:'control-plane-diagnostic'})});toast('Diagnostic completed');loadSaaSOps()}catch(e){toast(e.message)}}

async function loadWorkspaceSwitcher(){try{const d=await api('/api/workspaces');const current=Number(d.current_workspace_id);const other=(d.items||[]).filter(x=>Number(x.id)!==current);$('switchWorkspace').textContent=other.length?`Switch workspace (${other.length})`:'Current workspace';$('switchWorkspace').onclick=async()=>{if(!other.length){toast('No other workspace available');return}const pick=other.length===1?other[0]:other[Number(prompt(`Choose workspace number 1-${other.length}:`,'1')||1)-1];if(!pick)return;const r=await api('/api/workspaces/'+pick.id+'/switch',{method:'POST'});localStorage.setItem('feedbackos_token',r.token);location.reload()}}catch(e){}}
async function loadSecurityPolicy(){try{const d=await api('/api/workspace/settings');$('policyWorkspaceName').value=d.workspace?.name||'';$('policyTimezone').value=d.workspace?.timezone||'UTC';$('policySessionDays').value=d.policy?.session_days||30;$('policyAuditDays').value=d.policy?.audit_retention_days||365;$('savePolicy').onclick=async()=>{await api('/api/workspace/settings',{method:'PATCH',body:JSON.stringify({name:$('policyWorkspaceName').value,timezone:$('policyTimezone').value,policy:{session_days:Number($('policySessionDays').value||30),audit_retention_days:Number($('policyAuditDays').value||365),require_strong_password:true,allow_member_invites:false}})});toast('Workspace policy saved');loadSecurityPolicy()}}catch(e){$('savePolicy').disabled=true}}
async function loadSecurity(){
 try{ await loadWorkspaceSwitcher(); await loadSecurityPolicy();
  const rbac=await api('/api/security/rbac'); $('secRole').textContent=rbac.current_role; $('rbacMatrix').innerHTML=Object.entries(rbac.matrix||{}).map(([role,perms])=>`<div class="priority-item"><div class="priority-top"><b>${esc(role)}</b><span class="pill ${role===rbac.current_role?'low':'status'}">${role===rbac.current_role?'current':'role'}</span></div><div class="sub">${(perms||[]).map(esc).join(' · ')}</div></div>`).join('');
  if(rbac.current_role==='admin'){
   const cp=await api('/api/security/control-plane'); $('secMembers').textContent=cp.members.active; $('secMemberSub').textContent=`${cp.members.admins} admin · ${cp.members.managers} manager · ${cp.invitations.pending} pending invites`; $('secSessions').textContent=cp.sessions.active;
   const ss=await api('/api/security/sessions'); $('sessionList').innerHTML=(ss.items||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.name||x.email)}</b><span class="pill status">${esc(x.role)}</span></div><div class="sub">${esc(x.email)} · last seen ${x.last_seen_at?new Date(x.last_seen_at).toLocaleString():'never'}</div><div class="sub">${esc(x.user_agent||'Unknown device')}</div>${Number(x.user_id)!==Number(rbac.user_id)?`<button class="btn" style="margin-top:7px" onclick="revokeSession(${Number(x.id)})">Revoke session</button>`:''}</div>`).join('')||'<div class="empty">No active sessions.</div>';
   const ev=await api('/api/security/events'); $('securityEvents').innerHTML=(ev.items||[]).slice(0,12).map(x=>`<div class="priority-item"><b>${esc(x.event_type)}</b><div class="sub">${new Date(x.created_at).toLocaleString()} · ${esc(x.ip_address||'unknown IP')}</div></div>`).join('')||'<div class="empty">No security events yet.</div>';
   const iso=await api('/api/security/tenant-isolation'); $('secIsolation').textContent=iso.ok?'PASS':'FAIL'; $('secIsolationSub').textContent=`${iso.checked} tables checked · ${iso.failed.length} failed`; $('isolationChecks').innerHTML=(iso.checks||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.table)}</b><span class="pill ${x.pass?'low':'critical'}">${x.pass?'PASS':'FAIL'}</span></div><div class="sub">workspace column: ${x.workspace_column?'yes':'no'} · unscoped rows: ${Number(x.unscoped_rows||0)}</div></div>`).join('');
  } else { $('secMembers').textContent='—'; $('secMemberSub').textContent='Admin-only security metrics'; $('secSessions').textContent='—'; $('secIsolation').textContent='ADMIN'; $('secIsolationSub').textContent='Diagnostic restricted to admins'; $('sessionList').innerHTML='<div class="empty">Session management is restricted to workspace admins.</div>'; $('securityEvents').innerHTML='<div class="empty">Security events are restricted to workspace admins.</div>'; $('isolationChecks').innerHTML='<div class="empty">Tenant isolation diagnostic is restricted to workspace admins.</div>'; }
 }catch(e){toast(e.message)}
}
async function revokeSession(id){try{if(!confirm('Revoke this session?'))return;await api('/api/security/sessions/'+id,{method:'DELETE'});toast('Session revoked');loadSecurity()}catch(e){toast(e.message)}}
async function loadWorkspace(){try{const d=await api('/api/workspace');$('wsName').textContent=d.workspace.name;$('wsSlug').textContent=d.workspace.slug;$('wsMembers').textContent=(d.members||[]).length;$('wsInvites').textContent=(d.invites||[]).filter(x=>x.status==='pending').length;$('memberTable').innerHTML=`<table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th></tr></thead><tbody>${(d.members||[]).map(x=>`<tr><td><b>${esc(x.name)}</b></td><td>${esc(x.email)}</td><td>${esc(x.role)}</td><td>${esc(x.status)}</td></tr>`).join('')}</tbody></table>`;$('integrationList').innerHTML=(await api('/api/integrations')).items.map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.name)}</b><span class="pill low">${esc(x.status)}</span></div><div class="sub">${esc(x.type)} · ${x.last_event_at?'last event '+new Date(x.last_event_at).toLocaleString():'no events yet'}</div><button class="btn" style="margin-top:8px" onclick="testIntegration(${x.id})">Test connection</button></div>`).join('')||'<div class="empty">No integrations connected.</div>';$('wsIntegrations').textContent=(await api('/api/integrations')).items.length;const keys=await api('/api/api-keys');$('apiKeyList').innerHTML=(keys.items||[]).map(x=>`<div class="priority-item"><b>${esc(x.name)}</b><div class="sub">${esc(x.key_prefix)}… · ${x.revoked_at?'revoked':'active'}</div></div>`).join('')||'<div class="empty">No API keys.</div>';const audit=await api('/api/audit');$('auditList').innerHTML=(audit.items||[]).slice(0,12).map(x=>`<div class="priority-item"><b>${esc(x.event_type)}</b><div class="sub">${esc(x.user_name||'System')} · ${new Date(x.created_at).toLocaleString()}</div></div>`).join('')||'<div class="empty">No audit events yet.</div>'}catch(e){toast(e.message)}}
$('inviteBtn').onclick=async()=>{try{const d=await api('/api/workspace/invitations',{method:'POST',body:JSON.stringify({email:$('inviteEmail').value,role:$('inviteRole').value})});$('inviteResult').textContent=`Invite created. Token: ${d.invite_token}`;toast('Invitation created')}catch(e){toast(e.message)}};
$('integrationBtn').onclick=async()=>{try{await api('/api/integrations',{method:'POST',body:JSON.stringify({name:$('integrationName').value,type:$('integrationType').value})});toast('Integration connected');loadWorkspace()}catch(e){toast(e.message)}};
$('createKeyBtn').onclick=async()=>{try{const d=await api('/api/api-keys',{method:'POST',body:JSON.stringify({name:prompt('API key name:','Production ingestion')||'Integration key'})});alert('Copy this API key now — it will not be shown again:\n\n'+d.key);loadWorkspace()}catch(e){toast(e.message)}};
async function testIntegration(id){try{const d=await api('/api/integrations/'+id+'/test',{method:'POST'});toast('Integration checks passed')}catch(e){toast(e.message)}}
bootAuth();

let evalDatasetsCache=[];
async function loadAILab(){try{const o=await api('/api/ai-evaluation/overview');$('evalDatasets').textContent=o.datasets||0;$('evalRuns').textContent=o.runs||0;$('evalRegressions').textContent=o.regressions||0;const l=o.latest;if(l){$('evalScore').textContent=(Number(l.overall_score||0)*100).toFixed(1)+'%';$('evalScoreSub').textContent=`${esc(l.model)} · ${new Date(l.finished_at||l.started_at).toLocaleString()}`}else{$('evalScore').textContent='—';$('evalScoreSub').textContent='No completed run'}const ds=await api('/api/ai-evaluation/datasets');evalDatasetsCache=ds.items||[];$('evalDatasetSelect').innerHTML=evalDatasetsCache.map(d=>`<option value="${d.id}">${esc(d.name)} (${Number(d.case_count||0)} cases)</option>`).join('')||'<option value="">Create a dataset first</option>';await loadEvalCases();const runs=await api('/api/ai-evaluation/runs');$('evalRunList').innerHTML=(runs.items||[]).map(r=>`<div class="priority-item"><div class="priority-top"><b>#${Number(r.id)} · ${esc(r.name)}</b><span class="pill ${r.regressions>0?'critical':r.status==='failed'?'critical':'low'}">${esc(r.status)}${r.regressions>0?' · regression':''}</span></div><div class="sub">${esc(r.model)} · ${esc(r.prompt_version)} · ${Number(r.evaluated_cases||0)}/${Number(r.total_cases||0)} cases</div><div class="sub">Overall ${(Number(r.overall_score||0)*100).toFixed(1)}% · Sentiment ${(Number(r.sentiment_accuracy||0)*100).toFixed(1)}% · Category ${(Number(r.category_accuracy||0)*100).toFixed(1)}% · Severity ${(Number(r.severity_accuracy||0)*100).toFixed(1)}%</div>${r.error_message?`<div class="sub bad">${esc(r.error_message)}</div>`:''}</div>`).join('')||'<div class="empty">No evaluation runs yet.</div>'}catch(e){toast(e.message)}}
async function loadEvalCases(){const id=$('evalDatasetSelect').value;if(!id){$('evalCaseList').innerHTML='<div class="empty">Select or create a dataset.</div>';return}try{const d=await api('/api/ai-evaluation/datasets/'+id+'/cases');$('evalCaseCount').textContent=(d.items||[]).length+' cases';$('evalCaseList').innerHTML=(d.items||[]).map(c=>`<div class="priority-item"><div class="priority-top"><b>#${Number(c.id)} · ${esc(c.input_text).slice(0,140)}</b></div><div class="sub">Expected: ${esc(c.expected_sentiment||'—')} · ${esc(c.expected_category||'—')} · ${esc(c.expected_severity||'—')}</div><div class="sub">${esc(c.expected_summary||'No expected summary')}</div></div>`).join('')||'<div class="empty">No golden cases yet.</div>'}catch(e){toast(e.message)}}
async function createEvalDataset(){try{const d=await api('/api/ai-evaluation/datasets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:$('evalDatasetName').value,description:$('evalDatasetDescription').value})});toast('Golden dataset created');$('evalDatasetName').value='';$('evalDatasetDescription').value='';await loadAILab();$('evalDatasetSelect').value=d.id;loadEvalCases()}catch(e){toast(e.message)}}
async function addEvalCase(){try{const id=$('evalDatasetSelect').value;if(!id)return toast('Create a dataset first');await api('/api/ai-evaluation/datasets/'+id+'/cases',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({input_text:$('evalInput').value,expected_sentiment:$('evalSentiment').value,expected_category:$('evalCategory').value,expected_severity:$('evalSeverity').value,expected_summary:$('evalSummary').value})});toast('Golden case added');['evalInput','evalSentiment','evalCategory','evalSeverity','evalSummary'].forEach(x=>$(x).value='');loadAILab()}catch(e){toast(e.message)}}
async function runSelectedEvaluation(){try{const id=$('evalDatasetSelect').value;if(!id)return toast('Select a dataset first');const name=prompt('Evaluation run name (optional):','Regression check');const setBase=confirm('Set this run as the new baseline?');const d=await api('/api/ai-evaluation/datasets/'+id+'/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name||undefined,set_baseline:setBase?1:0})});toast(`Evaluation complete · ${(Number(d.metrics.overall_score)*100).toFixed(1)}%${d.regression?' · regression detected':''}`);loadAILab()}catch(e){toast(e.message)}}
async function loadAILearning(){try{const o=await api('/api/learning/overview');$('learnSignals').textContent=Number(o.open_signals||0);$('learnPatterns').textContent=Number(o.patterns||0);$('learnRuns').textContent=Number(o.runs||0);$('learnLast').textContent=o.last_run?.status==='completed'?'Complete':(o.last_run?.status||'—');$('learningPatterns').innerHTML=(o.top_patterns||[]).map(x=>`<div class="priority-item" style="margin-top:10px"><div class="priority-top"><b>${esc(x.field_name)}</b><span class="pill ${x.status==='approved'?'low':x.status==='rejected'?'critical':'medium'}">${esc(x.status)}</span></div><div class="sub">${Number(x.occurrence_count||0)} corrections · ${(Number(x.confidence||0)*100).toFixed(1)}% confidence</div><p>${esc(x.explanation)}</p><div class="toolbar"><button class="btn" onclick="reviewLearningPattern(${Number(x.id)},'approved')">Approve</button><button class="btn" onclick="reviewLearningPattern(${Number(x.id)},'rejected')">Reject</button></div></div>`).join('')||'<div class="empty">No candidate patterns yet. Human overrides create the evidence.</div>';const q=await api('/api/learning/signals');$('learningSignalsList').innerHTML=(q.items||[]).map(x=>`<div class="priority-item" style="margin-top:10px"><div class="priority-top"><b>${esc(x.signal_type)}</b><span class="pill medium">${(Number(x.confidence||0)*100).toFixed(1)}%</span></div><div class="sub">${esc(x.field_name||'AI output')} · ${Number(x.evidence_count||0)} evidence item(s)</div><p>${esc(x.explanation)}</p><div class="toolbar"><button class="btn" onclick="reviewLearningSignal(${Number(x.id)},'approved')">Approve</button><button class="btn" onclick="reviewLearningSignal(${Number(x.id)},'resolved')">Resolve</button></div></div>`).join('')||'<div class="empty">No open learning signals.</div>'}catch(e){toast(e.message)}}
async function runAILearning(){try{const d=await api('/api/learning/run',{method:'POST'});toast(`Learning analysis complete · ${Number(d.signals_created||0)} signals`);loadAILearning()}catch(e){toast(e.message)}}
async function reviewLearningSignal(id,status){try{await api('/api/learning/signals/'+id,{method:'PATCH',body:JSON.stringify({status})});loadAILearning()}catch(e){toast(e.message)}}
async function reviewLearningPattern(id,status){try{await api('/api/learning/patterns/'+id,{method:'PATCH',body:JSON.stringify({status})});loadAILearning()}catch(e){toast(e.message)}}

async function loadAIGovernance(){try{const d=await api('/api/ai/overview');const s=d.stats||{};$('aiRuns').textContent=Number(s.total||0);$('aiRunSub').textContent=Number(s.completed||0)+' completed · '+Number(s.failed||0)+' failed';const denom=Number(s.total||0);$('aiFailureRate').textContent=(denom?(Number(s.failed||0)/denom*100):0).toFixed(1)+'%';$('aiConfidence').textContent=(Number(s.avg_confidence||0)*100).toFixed(1)+'%';$('aiLowConfidence').textContent=Number(s.low_confidence||0)+' low-confidence runs';$('aiTokens').textContent=Number(s.tokens||0).toLocaleString();$('aiCost').textContent='$'+Number(s.estimated_cost_usd||0).toFixed(4)+' estimated';$('aiOverrides').textContent=Number(s.overrides||0);const p=d.settings||{};$('aiModel').value=p.model||'gpt-5-mini';$('aiMinConfidence').value=p.min_confidence??0.60;$('aiMaxRetries').value=p.max_retries??3;$('aiDailyBudget').value=p.daily_token_budget??0;$('aiHumanReview').checked=!!p.require_human_review;const r=await api('/api/ai/runs');$('aiRunList').innerHTML=(r.items||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>#${Number(x.id)} · ${esc(x.operation)}</b><span class="pill ${x.status==='failed'?'critical':x.status==='overridden'?'medium':'low'}">${esc(x.status)}</span></div><div class="sub">${esc(x.model)} · ${esc(x.prompt_version)} · ${x.confidence!=null?(Number(x.confidence)*100).toFixed(1)+'% confidence':''}</div><div class="sub">${Number(x.total_tokens||0).toLocaleString()} tokens · $${Number(x.estimated_cost_usd||0).toFixed(5)} · ${x.duration_ms||0} ms</div>${x.error_message?`<div class="sub bad">${esc(x.error_message)}</div>`:''}</div>`).join('')||'<div class="empty">No governed AI runs yet.</div>';const o=await api('/api/ai/overrides');$('aiOverrideList').innerHTML=(o.items||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>Feedback #${Number(x.feedback_id)} · ${esc(x.field_name)}</b><span class="pill medium">human override</span></div><div class="sub">${esc(x.user_name||'User')} · ${new Date(x.created_at).toLocaleString()}</div><div class="sub">${esc(x.old_value||'')} → ${esc(x.new_value||'')}</div>${x.reason?`<p>${esc(x.reason)}</p>`:''}</div>`).join('')||'<div class="empty">No human overrides yet.</div>'}catch(e){toast(e.message)}}
async function saveAIPolicy(){try{await api('/api/ai/settings',{method:'PATCH',body:JSON.stringify({model:$('aiModel').value,min_confidence:Number($('aiMinConfidence').value),max_retries:Number($('aiMaxRetries').value),daily_token_budget:Number($('aiDailyBudget').value),require_human_review:$('aiHumanReview').checked})});toast('AI policy saved');loadAIGovernance()}catch(e){toast(e.message)}}

async function loadQuality(){try{const d=await api('/api/quality/overview');const l=d.latest||{};$('qualityScore').textContent=l.score!=null?Number(l.score).toFixed(1):'—';$('qualityFlags').textContent=Number(d.open_flags||0);$('qualityCritical').textContent=Number(d.critical_flags||0)+' critical';$('qualityDuplicates').textContent=Number(l.duplicate_count||0);$('qualityAI').textContent=Number(l.ai_failure_count||0);$('qualityRetry').textContent=Number(d.retry_queue||0);$('qualityRun').innerHTML=l.id?`<div class="info-grid"><div class="info"><span>Scanned feedback</span><b>${Number(l.total_feedback||0)}</b></div><div class="info"><span>Valid feedback</span><b>${Number(l.valid_feedback||0)}</b></div><div class="info"><span>Quality issues</span><b>${Number(l.quality_issue_count||0)}</b></div><div class="info"><span>Low-confidence signals</span><b>${Number(l.low_confidence_count||0)}</b></div></div><div class="sub" style="margin-top:12px">${new Date(l.started_at).toLocaleString()}</div>`:'<div class="empty">Run the first quality scan.</div>';const f=await api('/api/quality/flags');$('qualityFlagList').innerHTML=(f.items||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>#${Number(x.feedback_id)} · ${esc(x.flag_type)}</b><span class="pill ${x.severity==='critical'?'critical':x.severity==='warning'?'medium':'low'}">${esc(x.severity)}</span></div><div class="sub">${esc(x.source||'unknown')} · ${esc(x.status)}</div><p>${esc(x.detail||'Quality issue detected.')}</p><div class="toolbar"><button class="btn" onclick="openProblem(0)">Feedback #${Number(x.feedback_id)}</button><button class="btn" onclick="resolveQualityFlag(${Number(x.id)})">Resolve</button>${x.flag_type==='classification_missing'?`<button class="btn primary" onclick="retryQuality(${Number(x.feedback_id)})">Retry AI</button>`:''}</div></div>`).join('')||'<div class="empty">No open quality flags.</div>';const q=await api('/api/quality/retries');$('qualityRetries').innerHTML=(q.items||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>Feedback #${Number(x.feedback_id)}</b><span class="pill ${x.status==='failed'?'critical':x.status==='completed'?'low':'medium'}">${esc(x.status)}</span></div><div class="sub">Attempts: ${Number(x.attempt_count||0)} · ${x.processed_at?new Date(x.processed_at).toLocaleString():'pending'}</div>${x.last_error?`<div class="sub bad">${esc(x.last_error)}</div>`:''}</div>`).join('')||'<div class="empty">No AI retries recorded.</div>'}catch(e){toast(e.message)}}
async function runQualityScan(){try{const b=event?.target;if(b)b.disabled=true;const d=await api('/api/quality/scan',{method:'POST'});toast(`Quality scan complete · score ${Number(d.score).toFixed(1)} · ${Number(d.open_flags)} flags`);loadQuality()}catch(e){toast(e.message)}finally{if(event?.target)event.target.disabled=false}}
async function resolveQualityFlag(id){try{await api('/api/quality/flags/'+id,{method:'PATCH',body:JSON.stringify({status:'resolved'})});toast('Quality flag resolved');loadQuality()}catch(e){toast(e.message)}}
async function retryQuality(id){try{const d=await api('/api/quality/retry/'+id,{method:'POST'});toast('AI classification retried successfully');loadQuality()}catch(e){toast(e.message)}}


async function loadReleaseBanner(){try{const d=await api('/api/release/status');const live=d.phases||[];const campaigns=d.campaigns||[];if(!live.length&&!campaigns.length)return;const c=campaigns[0],p=d.current_phase;const title=c?.headline||p?.tagline||`${p?.name||'New FeedbackOS release'} is live`;const body=c?.teaser||p?.description||'New capabilities are now available.';$('releaseBanner').style.display='block';$('releaseBanner').innerHTML=`<div style="display:flex;justify-content:space-between;gap:15px;align-items:center"><div><div style="font-size:11px;opacity:.7;text-transform:uppercase;letter-spacing:.08em">New release</div><b style="font-size:16px">${esc(title)}</b><div style="opacity:.78;margin-top:3px">${esc(body)}</div></div>${c?.cta_url?`<a class="btn primary" href="${esc(c.cta_url)}">${esc(c.cta_label||'Explore')}</a>`:''}</div>`}catch(e){}}

async function loadLaunchAnalytics(){try{const d=await api('/api/superadmin/launch-analytics?days='+Number($('laDays').value||30)),f=d.funnel||{},c=d.conversion||{};$('lanWait').textContent=Number(f.waitlist_signups||0).toLocaleString();$('lanBeta').textContent=Number(f.beta_activations||0).toLocaleString();$('lanCheckout').textContent=Number(f.checkout_starts||0).toLocaleString();$('lanUpgrades').textContent=Number(f.upgrades||0).toLocaleString();const steps=[['Teaser views',f.teaser_views],['Announcement views',f.announcement_views],['Waitlist signups',f.waitlist_signups],['Beta activations',f.beta_activations],['Feature views',f.feature_views],['Upgrade prompts',f.upgrade_prompts],['Checkout starts',f.checkout_starts],['Paid conversions',f.upgrades]];$('lanFunnel').innerHTML=steps.map((x,i)=>`<div class="plan-row"><div><b>${esc(x[0])}</b><div class="sub">${i===2?'From teaser: '+c.waitlist_from_teaser+'%':i===3?'From waitlist: '+c.beta_from_waitlist+'%':i===6?'From prompt: '+c.checkout_from_prompt+'%':i===7?'From checkout: '+c.upgrade_from_checkout+'%':''}</div></div><span class="pill">${Number(x[1]||0).toLocaleString()}</span></div>`).join('');$('lanRecommendations').innerHTML=(d.recommendations||[]).map(r=>`<div class="priority-item"><div class="priority-top"><b>${esc(r.title)}</b><span class="pill ${r.priority==='high'?'critical':r.priority==='medium'?'medium':'low'}">${esc(r.priority)}</span></div><p>${esc(r.body)}</p></div>`).join('')||'<div class="empty">No recommendations.</div>';$('lanGoals').innerHTML=(d.goals||[]).map(g=>`<div class="priority-item"><div class="priority-top"><div><b>${esc(g.name)}</b><div class="sub">${esc(g.metric_key)} · target ${Number(g.target_value).toLocaleString()}</div></div><span class="pill ${g.achieved?'low':'medium'}">${g.achieved?'ACHIEVED':Number(g.progress).toFixed(1)+'%'}</span></div><div class="sub">Current: ${Number(g.current_value||0).toLocaleString()}${g.due_date?' · due '+esc(g.due_date):''}</div></div>`).join('')||'<div class="empty">No launch goals.</div>';$('lanPhases').innerHTML=(d.by_phase||[]).map(x=>`<div class="plan-row"><div><b>${esc(x.name)}</b><div class="sub">${esc(x.phase_key)} · ${Number(x.events||0)} events</div></div><span class="pill">${Number(x.waitlist_signups||0)} waitlist</span></div>`).join('')||'<div class="empty">No phase activity.</div>';$('lanFeatures').innerHTML=(d.by_feature||[]).map(x=>`<div class="plan-row"><b>${esc(x.feature_key)}</b><span class="pill">${Number(x.views||0)} views</span></div>`).join('')||'<div class="empty">No feature interest data.</div>'}catch(e){toast(e.message)}}
async function snapshotLaunchAnalytics(){try{const d=await api('/api/superadmin/launch-analytics/snapshot',{method:'POST',body:JSON.stringify({days:Number($('laDays').value||30)})});toast('Launch analytics snapshot saved');loadLaunchAnalytics()}catch(e){toast(e.message)}}

async function loadLaunchAdmin(){try{const d=await api('/api/superadmin/launch-experience');const wait=(d.waitlist||[]).reduce((a,x)=>a+Number(x.count||0),0),beta=(d.beta||[]).reduce((a,x)=>a+Number(x.count||0),0),events=(d.events||[]).reduce((a,x)=>a+Number(x.count||0),0);$('laWait').textContent=wait.toLocaleString();$('laBeta').textContent=beta.toLocaleString();$('laEvents').textContent=events.toLocaleString();$('laExperiences').textContent=Number((d.experiences||[]).length).toLocaleString();$('laPhase').innerHTML=(d.experiences||[]).map(x=>`<option value="${Number(x.phase_id||0)}">${esc(x.phase_name||'No phase')}</option>`).join('');$('launchAdminList').innerHTML=(d.experiences||[]).map(x=>`<div class="plan-row"><div style="flex:1"><b>${esc(x.headline)}</b><div class="sub">${esc(x.experience_key)} · ${esc(x.phase_name||'')} · ${esc(x.stage)}</div></div><button class="btn ${x.enabled?'':'primary'}" onclick="setLaunchExperience(${x.id},${x.enabled?0:1})">${x.enabled?'Disable':'Enable'}</button></div>`).join('')||'<div class="empty">No launch experiences.</div>'}catch(e){toast(e.message)}}
async function setLaunchExperience(id,enabled){try{await api('/api/superadmin/launch-experience/'+id,{method:'PATCH',body:JSON.stringify({enabled})});toast(enabled?'Launch experience enabled':'Launch experience disabled');loadLaunchAdmin();loadLaunchExperience()}catch(e){toast(e.message)}}
async function createLaunchExperience(){try{await api('/api/superadmin/launch-experience',{method:'POST',body:JSON.stringify({experience_key:$('laKey').value,headline:$('laHeadline').value,subheadline:$('laSub').value,body:$('laBody').value,phase_id:Number($('laPhase').value)||null,stage:$('laStage').value,feature_key:$('laFeature').value})});toast('Launch experience created');loadLaunchAdmin()}catch(e){toast(e.message)}}
async function loadProductOS(){try{const d=await api('/api/superadmin/product');$('poPaid').textContent=Number(d.metrics?.paid_workspaces||0).toLocaleString();$('poMrr').textContent='$'+Number(d.metrics?.mrr||0).toLocaleString();$('poEvents').textContent=Number(d.conversions?.total_upgrade_events||0).toLocaleString();$('poUpgrades').textContent=Number(d.conversions?.upgrades||0).toLocaleString();$('poFeatures').innerHTML=(d.features||[]).map(f=>{const fl=(d.flags||[]).find(x=>x.feature_key===f.feature_key);return `<div class="priority-item" style="margin-bottom:10px"><div class="priority-top"><div><b>${esc(f.name)}</b><div class="sub">${esc(f.feature_key)} · ${esc(f.phase_name||'No phase')}</div></div><span class="pill ${fl?.enabled?'low':'status'}">${fl?.enabled?'ENABLED':'OFF'}</span></div><p>${esc(f.description||'')}</p><div class="toolbar"><button class="btn ${fl?.enabled?'':'primary'}" onclick="toggleProductFlag('${esc(f.feature_key)}',${fl?.enabled?0:1})">${fl?.enabled?'Disable':'Enable'} feature</button><span class="pill">Rollout ${Number(fl?.rollout_percent??100)}%</span></div></div>`}).join('')||'<div class="empty">No product features.</div>';$('poPlans').innerHTML=(d.plans||[]).map(p=>`<div class="plan-row"><div style="flex:1"><b>${esc(p.name)}</b><div class="sub">${esc(p.plan_key)} · $${Number(p.price_monthly).toLocaleString()}/month</div></div><span class="pill">${esc(p.status)}</span></div>`).join('');$('poPrompts').innerHTML=(d.prompts||[]).map(p=>`<div class="priority-item" style="margin-bottom:8px"><b>${esc(p.headline)}</b><div class="sub">${esc(p.plan_from)} → ${esc(p.plan_to)} · ${p.enabled?'live':'off'}</div><p>${esc(p.body||'')}</p></div>`).join('')||'<div class="empty">No upgrade prompts.</div>';$('poRoadmap').innerHTML=(d.roadmap||[]).map(r=>`<div class="plan-row"><div style="flex:1"><b>${esc(r.title)}</b><div class="sub">${esc(r.status)} · ${r.target_date||'No target date'}</div><div class="sub">${esc(r.description||'')}</div></div><span class="pill">${esc(r.visibility)}</span></div>`).join('')||'<div class="empty">No roadmap items.</div>';$('poWaitlist').innerHTML=(d.waitlist||[]).map(w=>`<div class="plan-row"><div style="flex:1"><b>${esc(w.email)}</b><div class="sub">${esc(w.name||'')} ${w.company?'· '+esc(w.company):''}</div></div><span class="pill">${esc(w.phase_key||'general')} · ${esc(w.status)}</span></div>`).join('')||'<div class="empty">No waitlist entries.</div>'}catch(e){toast(e.message)}}
async function toggleProductFlag(key,enabled){try{await api('/api/superadmin/flags/'+encodeURIComponent(key),{method:'PATCH',body:JSON.stringify({enabled})});toast(enabled?'Feature enabled':'Feature disabled');loadProductOS();loadReleaseBanner()}catch(e){toast(e.message)}}
async function loadSuperAdmin(){try{const d=await api('/api/superadmin/overview');$('saUsers').textContent=Number(d.stats.users||0).toLocaleString();$('saWorkspaces').textContent=Number(d.stats.workspaces||0).toLocaleString();$('saPaid').textContent=Number(d.stats.paid_workspaces||0).toLocaleString();$('saMrr').textContent='$'+Number(d.stats.mrr||0).toLocaleString();$('saLive').textContent=(d.phases||[]).filter(x=>x.launch_enabled).length;const phases=d.phases||[];$('saCampaignPhase').innerHTML=phases.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join('');$('saPhases').innerHTML=phases.map(p=>{const bs=p.benchmarks||[];const passed=bs.filter(x=>x.eligible).length;const blocked=bs.filter(x=>x.gate_required&&!x.eligible).length;return `<div class="priority-item" style="margin-bottom:10px"><div class="priority-top"><div><b>${esc(p.name)}</b><div class="sub">${esc(p.tagline||'')} · ${esc(p.plan_tier)} · ${esc(p.status)}</div></div><span class="pill ${p.launch_enabled?'low':blocked?'medium':'status'}">${p.launch_enabled?'LIVE':blocked?'GATED':'DRAFT'}</span></div><p>${esc(p.description||'')}</p><div class="info-grid">${bs.map(b=>`<div class="info"><span>${esc(b.label)}</span><b>${b.current_value==null?'—':Number(b.current_value).toLocaleString()} / ${Number(b.target_value).toLocaleString()} ${b.eligible?'✓':''}</b></div>`).join('')}</div><div class="sub" style="margin-top:8px">${passed}/${bs.length||0} benchmark gates passed · ${p.features?.length||0} features</div><div class="toolbar" style="margin-top:10px">${p.launch_enabled?`<button class="btn" onclick="pauseSuperPhase(${p.id})">Pause release</button>`:`<button class="btn primary" onclick="launchSuperPhase(${p.id})">Launch phase</button><button class="btn" onclick="launchSuperPhase(${p.id},true)">Force launch</button>`}</div><div style="margin-top:10px">${(p.features||[]).map(f=>`<span class="pill ${f.enabled?'low':'status'}" style="margin:2px">${esc(f.name)} · ${esc(f.plan_tier)}</span>`).join('')}</div></div>`}).join('')||'<div class="empty">No phases configured.</div>';$('saCampaigns').innerHTML=(d.campaigns||[]).map(c=>`<div class="priority-item" style="margin-bottom:10px"><div class="priority-top"><b>${esc(c.name)}</b><span class="pill ${c.status==='live'?'low':c.status==='ended'?'status':'medium'}">${esc(c.status)}</span></div><div class="sub">${esc(c.headline)} · audience: ${esc(c.audience)}</div><p>${esc(c.teaser||c.body||'')}</p><div class="toolbar">${c.status!=='live'&&c.status!=='ended'?`<button class="btn primary" onclick="publishCampaign(${c.id})">Publish</button>`:''}${c.status==='live'?`<button class="btn" onclick="endCampaign(${c.id})">End campaign</button>`:''}</div></div>`).join('')||'<div class="empty">No campaigns yet.</div>'}catch(e){toast(e.message)}}
async function createSuperPhase(){try{await api('/api/superadmin/phases',{method:'POST',body:JSON.stringify({phase_key:$('saPhaseKey').value,name:$('saPhaseName').value,tagline:$('saPhaseTagline').value,description:$('saPhaseDescription').value,plan_tier:$('saPhaseTier').value,sort_order:Number($('saPhaseOrder').value||100)})});toast('Release phase created');loadSuperAdmin();loadLaunchAdmin()}catch(e){toast(e.message)}}
async function launchSuperPhase(id,force=false){try{const r=await api('/api/superadmin/phases/'+id+'/launch',{method:'POST',body:JSON.stringify(force?{force:true}:{})});toast(force?'Phase force-launched':'Phase launched');loadSuperAdmin();loadReleaseBanner()}catch(e){toast(e.message)}}
async function pauseSuperPhase(id){try{await api('/api/superadmin/phases/'+id+'/pause',{method:'POST'});toast('Phase paused');loadSuperAdmin();loadReleaseBanner()}catch(e){toast(e.message)}}
async function createSuperCampaign(){try{await api('/api/superadmin/campaigns',{method:'POST',body:JSON.stringify({phase_id:Number($('saCampaignPhase').value)||null,name:$('saCampaignName').value,headline:$('saCampaignHeadline').value,teaser:$('saCampaignTeaser').value,body:$('saCampaignBody').value,cta_label:$('saCampaignCTA').value,cta_url:$('saCampaignURL').value,audience:$('saCampaignAudience').value})});toast('Campaign created');loadSuperAdmin()}catch(e){toast(e.message)}}
async function publishCampaign(id){try{await api('/api/superadmin/campaigns/'+id+'/live',{method:'POST'});toast('Campaign published');loadSuperAdmin();loadReleaseBanner()}catch(e){toast(e.message)}}
async function endCampaign(id){try{await api('/api/superadmin/campaigns/'+id+'/end',{method:'POST'});toast('Campaign ended');loadSuperAdmin();loadReleaseBanner()}catch(e){toast(e.message)}}


async function loadExperiments(){try{const d=await api('/api/superadmin/experiments'),items=d.experiments||[];$('exCount').textContent=items.length.toLocaleString();$('exRunning').textContent=items.filter(x=>x.status==='running').length.toLocaleString();$('exAssignments').textContent=items.reduce((n,x)=>n+Number(x.summary?.assignments||0),0).toLocaleString();$('exConversions').textContent=items.reduce((n,x)=>n+Number(x.summary?.conversions||0),0).toLocaleString();$('experimentList').innerHTML=items.map(x=>`<div class="priority-item" style="margin-bottom:12px"><div class="priority-top"><div><b>${esc(x.name)}</b><div class="sub">${esc(x.experiment_key)} · ${esc(x.metric_key)} · ${esc(x.audience)}</div></div><span class="pill ${x.status==='running'?'low':x.status==='completed'?'status':'medium'}">${esc(x.status)}</span></div><p>${esc(x.hypothesis||'No hypothesis')}</p><div class="info-grid">${(x.variants||[]).map(v=>`<div class="info"><span>${esc(v.name)} · ${Number(v.allocation_percent)}%</span><b>${Number(v.assignments||0)} assigned · ${Number(v.conversions||0)} conversions</b><div class="sub">${Number(v.assignments||0)?((Number(v.conversions||0)/Number(v.assignments||0)*100).toFixed(1)+'% conversion'): 'No outcome data yet'}</div></div>`).join('')}</div><div class="toolbar" style="margin-top:10px">${x.status==='draft'?`<button class="btn primary" onclick="addDefaultVariants(${x.id})">Add A/B variants</button>`:''}${x.status==='draft'?`<button class="btn" onclick="startExperiment(${x.id})">Start</button>`:''}${x.status==='running'?`<button class="btn" onclick="pauseExperiment(${x.id})">Pause</button><button class="btn" onclick="viewExperimentReport(${x.id})">View report</button>`:''}${x.status==='paused'?`<button class="btn primary" onclick="startExperiment(${x.id})">Resume</button>`:''}${x.status==='running'?`<button class="btn" onclick="completeExperiment(${x.id})">Complete</button>`:''}</div></div>`).join('')||'<div class="empty">No experiments yet.</div>'}catch(e){toast(e.message)}}
async function createExperiment(){try{await api('/api/superadmin/experiments',{method:'POST',body:JSON.stringify({experiment_key:$('exKey').value,name:$('exName').value,hypothesis:$('exHypothesis').value,metric_key:$('exMetric').value,audience:$('exAudience').value})});toast('Experiment created');$('exKey').value='';$('exName').value='';loadExperiments()}catch(e){toast(e.message)}}
async function addDefaultVariants(id){try{await api('/api/superadmin/experiments/'+id+'/variants',{method:'POST',body:JSON.stringify({variant_key:'control',name:'Control',headline:'Current message',allocation_percent:50})});await api('/api/superadmin/experiments/'+id+'/variants',{method:'POST',body:JSON.stringify({variant_key:'challenger',name:'Challenger',headline:'New message',allocation_percent:50})});toast('Control + challenger variants created');loadExperiments()}catch(e){toast(e.message)}}
async function startExperiment(id){try{await api('/api/superadmin/experiments/'+id+'/start',{method:'POST'});toast('Experiment started');loadExperiments()}catch(e){toast(e.message)}}
async function pauseExperiment(id){try{await api('/api/superadmin/experiments/'+id,{method:'PATCH',body:JSON.stringify({status:'paused'})});toast('Experiment paused');loadExperiments()}catch(e){toast(e.message)}}
async function completeExperiment(id){try{const r=await api('/api/superadmin/experiments/'+id+'/report');const best=(r.variants||[]).sort((a,b)=>Number(b.conversion_rate)-Number(a.conversion_rate))[0];await api('/api/superadmin/experiments/'+id+'/complete',{method:'POST',body:JSON.stringify({winner_variant_id:best?.id||null})});toast(best?`Experiment completed. Winner: ${best.variant_key}`:'Experiment completed');loadExperiments()}catch(e){toast(e.message)}}
async function viewExperimentReport(id){try{const r=await api('/api/superadmin/experiments/'+id+'/report');const lines=(r.variants||[]).map(v=>`${v.name}: ${v.assignments} assigned, ${v.conversions} conversions (${v.conversion_rate}%)`).join('\\n');alert(`${r.experiment.name}\\n\\n${lines}\\n\\n${r.recommendation}`)}catch(e){toast(e.message)}}

async function loadLaunchExperience(){
 try {
  const d=await api('/api/launch/experience'), ex=d.experiences||[], camps=d.campaigns||[];
  const campaignHtml=camps.map(c=>`<div class="priority-item" style="margin-bottom:10px"><div class="priority-top"><div><b>${esc(c.headline)}</b><div class="sub">Launch campaign · ${esc(c.audience)}</div></div><span class="pill low">LIVE</span></div><p>${esc(c.teaser||c.body||'')}</p>${c.cta_url?`<a class="btn primary" href="${esc(c.cta_url)}">${esc(c.cta_label||'Explore')}</a>`:''}</div>`).join('');
  const experienceHtml=ex.map(x=>{const wait=x.stage!=='launched'?`<button class="btn primary" onclick="joinPhaseWaitlist('${esc(x.phase_key||'')}')">Join early access</button>`:'';const learn=x.feature_key?`<button class="btn" onclick="trackLaunchEvent('feature_viewed',null,'${esc(x.feature_key)}')">Learn more</button>`:'';const cls=x.stage==='launched'?'low':x.stage==='beta'?'medium':'status';return `<div class="priority-item" style="margin-bottom:10px"><div class="priority-top"><div><b>${esc(x.headline)}</b><div class="sub">${esc(x.phase_name||'Release')} · ${esc(x.stage)}</div></div><span class="pill ${cls}">${esc(String(x.stage).toUpperCase())}</span></div><p>${esc(x.subheadline||'')}</p><div class="sub">${esc(x.body||'')}</div><div class="toolbar" style="margin-top:10px">${wait}${learn}</div></div>`}).join('');
  $('launchExperiences').innerHTML=campaignHtml+experienceHtml||'<div class="empty">No current release announcements.</div>';
  $('launchWaitPhase').innerHTML='<option value="">Next release</option>'+ex.filter(x=>x.stage!=='launched').map(x=>`<option value="${esc(x.phase_key||'')}">${esc(x.phase_name||x.headline)}</option>`).join('');
  try { const beta=await api('/api/launch/beta'); $('betaAccessList').innerHTML=(beta.items||[]).map(x=>`<div class="plan-row"><div style="flex:1"><b>${esc(x.feature_key||'Beta access')}</b><div class="sub">${esc(x.phase_name||'Release')}</div></div><span class="pill ${x.status==='active'?'low':x.status==='revoked'?'status':'medium'}">${esc(x.status)}</span></div>`).join('')||'<div class="empty">No beta access yet.</div>'; } catch(e) { $('betaAccessList').innerHTML='<div class="empty">Sign in to view beta access.</div>'; }
 } catch(e){toast(e.message)}
}

async function trackLaunchEvent(event_type,phase_id=null,feature_key=null){try{await api('/api/launch/events',{method:'POST',body:JSON.stringify({event_type,phase_id,feature_key})})}catch(e){}}
async function joinLaunchWaitlist(){try{await api('/api/launch/waitlist',{method:'POST',body:JSON.stringify({email:$('launchWaitEmail').value,name:$('launchWaitName').value,company:$('launchWaitCompany').value,phase_key:$('launchWaitPhase').value})});toast('You are on the early-access list');trackLaunchEvent('waitlist_joined');}catch(e){toast(e.message)}}
async function joinPhaseWaitlist(phase){$('launchWaitPhase').value=phase;document.getElementById('launchWaitEmail').focus();toast('Enter your email to join early access')}


async function loadRetention(){try{const d=await api('/api/retention/overview?days='+encodeURIComponent($('retDays').value));const s=d.summary||{};$('retHealth').textContent=Number(s.average_health||0).toFixed(1);$('retChurn').textContent=Number(s.churn_risk||0)+Number(s.at_risk||0);$('retRevenue').textContent='$'+Number(s.revenue_at_risk||0).toLocaleString(undefined,{maximumFractionDigits:0});$('retExpansion').textContent=Number(s.expansion||0);$('retCustomers').innerHTML=(d.at_risk_customers||[]).slice(0,30).map(x=>`<div class="plan-row"><div><b>${esc(x.customer_name)}</b><div class="sub">${esc(x.status)} · ${Number(x.health_score).toFixed(0)} health · ${Number(x.negative_rate).toFixed(1)}% negative</div><div class="sub">${(x.signals||[]).map(esc).join(' · ')}</div></div><strong>${Number(x.feedback_30d||0)} feedback</strong></div>`).join('')||'<div class="empty">No customers currently need attention.</div>';$('retExpansionList').innerHTML=(d.expansion_opportunities||[]).map(x=>`<div class="plan-row"><div><b>${esc(x.customer_name)}</b><div class="sub">${(x.signals||[]).map(esc).join(' · ')}</div></div><strong>${Number(x.health_score).toFixed(0)}</strong></div>`).join('')||'<div class="empty">No expansion signals yet.</div>';$('retReasons').innerHTML=(d.churn_reasons||[]).map(x=>`<div class="plan-row"><b>${esc(x.reason)}</b><strong>${Number(x.count||0)}</strong></div>`).join('')||'<div class="empty">No negative feedback reasons.</div>';$('retCohorts').innerHTML=(d.cohorts||[]).map(x=>`<div class="plan-row"><div><b>${esc(x.cohort)}</b><div class="sub">${Number(x.customers||0)} customers · ${Number(x.at_risk||0)} at risk</div></div><strong>${Number(x.avg_health||0).toFixed(1)}</strong></div>`).join('')||'<div class="empty">No cohort data.</div>';}catch(e){toast(e.message)}}
async function snapshotRetention(){try{await api('/api/retention/snapshot',{method:'POST',body:JSON.stringify({days:Number($('retDays').value)})});toast('Retention snapshot saved');}catch(e){toast(e.message)}}

async function loadRevenue(){try{const d=await api('/api/superadmin/revenue?days='+encodeURIComponent($('revDays').value));$('revMrr').textContent='$'+Number(d.base.mrr||0).toLocaleString(undefined,{maximumFractionDigits:0});$('revPaid').textContent=Number(d.base.paid_workspaces||0).toLocaleString();$('revIntent').textContent=Number(d.intent_conversion||0).toFixed(1)+'%';$('revCheckout').textContent=Number(d.upgrade_funnel.checkout_to_upgrade||0).toFixed(1)+'%';$('revPlans').innerHTML=(d.plans||[]).map(x=>`<div class="plan-row"><div><b>${esc(x.plan_key)}</b><div class="sub">${Number(x.workspaces||0)} workspaces</div></div><strong>$${Number(x.mrr||0).toLocaleString(undefined,{maximumFractionDigits:0})} MRR</strong></div>`).join('')||'<div class="empty">No plan data.</div>';$('revRecommendations').innerHTML=(d.recommendations||[]).map(x=>`<div class="priority-item"><div class="priority-top"><b>${esc(x.title)}</b><span class="pill ${x.priority==='high'?'critical':'medium'}">${esc(x.priority)}</span></div><p>${esc(x.body)}</p></div>`).join('')||'<div class="empty">No recommendations.</div>';$('revFeatures').innerHTML=(d.features||[]).map(x=>`<div class="plan-row"><div><b>${esc(x.feature_key||'Unattributed')}</b><div class="sub">${Number(x.attributions||0)} attribution events</div></div><strong>$${Number(x.attributed_revenue||0).toLocaleString(undefined,{maximumFractionDigits:2})}</strong></div>`).join('')||'<div class="empty">No revenue attribution yet.</div>';}catch(e){toast(e.message)}}
async function activateSubscription(){try{const id=Number($('revWorkspaceId').value);if(!id)return toast('Workspace ID is required');await api('/api/superadmin/subscriptions',{method:'POST',body:JSON.stringify({workspace_id:id,plan_key:$('revPlan').value,billing_cycle:$('revCycle').value,trial_days:Number($('revTrial').value||0)})});toast('Subscription activated');loadRevenue()}catch(e){toast(e.message)}}
</script>
</body>
</html>